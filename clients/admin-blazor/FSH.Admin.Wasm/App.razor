@using FSH.BlazorShared.Theming
@using FSH.BlazorShared.Components
@inject FshThemeService Theme

<MudThemeProvider Theme="FshMudTheme.CreateAdmin()" IsDarkMode="@Theme.IsDarkMode" IsDarkModeChanged="@OnThemeChanged" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <MudOverlay Visible="true">
                        <MudProgressCircular Indeterminate="true" />
                    </MudOverlay>
                </Authorizing>
            </AuthorizeRouteView>
        </Found>
        <NotFound>
            <FshNotFound />
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private async Task OnThemeChanged(bool isDarkMode)
        => await Theme.SetAsync(isDarkMode);
}
