@namespace FSH.Admin.Wasm.Pages.Audits
@using FSH.BlazorShared.Models.Audits
@using FSH.BlazorShared.Services

<div class="px-6 py-4" style="border-bottom: 1px solid var(--mud-palette-divider);">
    <div class="d-flex align-center gap-2 mb-2">
        <MudIcon Icon="@Icons.Material.Filled.Fingerprint" Size="Size.Small"
                 Style="color: var(--mud-palette-text-secondary);" />
        <MudText Class="fsh-mono-label mb-0">CORRELATION</MudText>
        <MudText Typo="Typo.caption" Color="Color.Secondary">— paste into your observability stack</MudText>
    </div>
    <div class="d-flex flex-column flex-md-row gap-2">
        <div class="flex-grow-1">
            <AuditCorrelationChip Label="Trace id" Value="@Detail.TraceId" />
        </div>
        <div class="flex-grow-1">
            <AuditCorrelationChip Label="Span id" Value="@Detail.SpanId" />
        </div>
        <div class="flex-grow-1">
            <AuditCorrelationChip Label="Correlation id" Value="@Detail.CorrelationId" />
        </div>
        <div class="flex-grow-1">
            <AuditCorrelationChip Label="Request id" Value="@Detail.RequestId" />
        </div>
    </div>
</div>

@code {
    [Parameter]
    public AuditDetailDto Detail { get; set; } = default!;
}
