@namespace FSH.Admin.Wasm.Pages.Settings
@using FSH.BlazorShared.Models.Identity

<MudCard Elevation="1" Class="pa-4 mb-4">
    <div class="d-flex align-center gap-3 mb-3">
        <FshToneIconTile Icon="@Icons.Material.Filled.Key" Tone="Color.Primary" TileSize="40px" IconSize="Size.Small" />
        <div>
            <MudText Typo="Typo.subtitle1" Class="font-weight-medium" Style="margin: 0;">Password</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Use at least 8 characters with a mix of letters, numbers, and symbols.</MudText>
        </div>
    </div>

    <MudForm @ref="_form">
        <div class="row">
            <div class="col-12 col-sm-6">
                <MudTextField Label="Current password" @bind-Value="_current" InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1"
                              For="@(() => _current)" Required="true" ErrorText="Required." />
            </div>
        </div>
        <div class="row">
            <div class="col-12 col-sm-6">
                <MudTextField Label="New password" @bind-Value="_next" InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1"
                              For="@(() => _next)" Required="true" ErrorText="At least 8 characters."
                              Validation="PasswordLengthRule" />
            </div>
            <div class="col-12 col-sm-6">
                <MudTextField Label="Confirm new password" @bind-Value="_confirm" InputType="InputType.Password"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-1"
                              For="@(() => _confirm)" Required="true"
                              Validation="ConfirmPasswordRule" ErrorText="Passwords don't match." />
            </div>
        </div>
        <div class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_saving" OnClick="ChangePasswordAsync">
                @(_saving ? "Saving…" : "Change password")
            </MudButton>
            @if (_saved is not null)
            {
                <MudText Typo="Typo.body2" Color="Color.Success" Class="mt-2">@_saved</MudText>
            }
        </div>
    </MudForm>
</MudCard>

@code {
    [Inject] private IUserService UserService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    private MudForm? _form;
    private string _current = string.Empty;
    private string _next = string.Empty;
    private string _confirm = string.Empty;
    private bool _saving;
    private string? _saved;

    private Func<string, string?> PasswordLengthRule => value =>
        string.IsNullOrEmpty(value) || value.Length < 8 ? "At least 8 characters." : null;

    private Func<string, string?> ConfirmPasswordRule => value =>
        value != _next ? "Passwords don't match." : null;

    private async Task ChangePasswordAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid)
        {
            return;
        }

        if (_next == _current)
        {
            Snackbar.Add("New password must differ from the current one.", Severity.Error);
            return;
        }

        _saving = true;
        _saved = null;
        try
        {
            await UserService.ChangePasswordAsync(new ChangePasswordRequest(_current, _next, _confirm));
            _saved = "Password updated.";
            Snackbar.Add("Password updated", Severity.Success);
            _current = string.Empty;
            _next = string.Empty;
            _confirm = string.Empty;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Change password failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }
}
