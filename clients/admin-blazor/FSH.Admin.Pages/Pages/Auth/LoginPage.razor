@page "/login"
@inject IAuthService AuthService
@inject AuthStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IPermissionsProvider PermissionsProvider

<div class="position-relative d-flex align-center justify-center" style="min-height: 100vh; background: var(--mud-palette-background); overflow: hidden;">
    <div class="fsh-orb" style="width: 420px; height: 420px; background: color-mix(in srgb, var(--mud-palette-primary) 6%, transparent); top: -120px; left: -80px;"></div>
    <div class="fsh-orb" style="width: 360px; height: 360px; background: color-mix(in srgb, var(--mud-palette-primary) 5%, transparent); bottom: -100px; right: -60px;"></div>

    <MudPaper Class="fsh-login-card pa-8 position-relative" Style="width: 420px; max-width: 92vw;" Elevation="0"
              Outlined="true">
        <div class="d-flex flex-column align-center mb-6">
            <div class="fsh-brand-mark mb-3" style="width: 44px; height: 44px; border-radius: 12px; font-size: 18px;">F</div>
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mt-2 font-weight-medium" Style="margin: 0;">Welcome back</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-1">Sign in to your operator account</MudText>
            <div class="d-flex align-center gap-2 mt-3">
                <div style="height: 1px; width: 24px; background: var(--mud-palette-divider);"></div>
                <MudText Class="fsh-mono-label" Color="Color.Secondary">Platform Admin</MudText>
                <div style="height: 1px; width: 24px; background: var(--mud-palette-divider);"></div>
            </div>
        </div>

        @if (_signedOutReason is not null)
        {
            <div role="status" class="d-flex align-center gap-2 rounded-lg px-3 py-2 mb-4"
                 style="background: color-mix(in srgb, var(--mud-palette-warning) 10%, transparent); border: 1px solid color-mix(in srgb, var(--mud-palette-warning) 30%, transparent);">
                <MudIcon Icon="@Icons.Material.Filled.HourglassTop" Color="Color.Warning" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-warning);">@_signedOutReason</MudText>
            </div>
        }

        @if (_error is not null)
        {
            <div role="alert" class="d-flex align-center gap-2 rounded-lg px-3 py-2 mb-4"
                 style="background: color-mix(in srgb, var(--mud-palette-error) 6%, transparent); border: 1px solid color-mix(in srgb, var(--mud-palette-error) 30%, transparent);">
                <MudIcon Icon="@Icons.Material.Filled.ReportGmailerrorred" Color="Color.Error" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-error);">@_error</MudText>
            </div>
        }

        <MudForm @ref="_form" Validation="@(new DataAnnotationsValidator())" OnEnterPressed="SubmitAsync">
            <MudTextField @bind-Value="_tenant"
                          Label="Tenant"
                          For="@(() => _tenant)"
                          autocomplete="organization"
                          Placeholder="root"
                          HelperText="Enter 'root' for SuperAdmin access"
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_email"
                          Label="Email"
                          For="@(() => _email)"
                          autocomplete="email"
                          Placeholder="operator@root.example"
                          Required="true"
                          RequiredError="Email is required."
                          Disabled="@_isSubmitting"
                          Class="mt-4" />
            <MudTextField @bind-Value="_password"
                          Label="Password"
                          For="@(() => _password)"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          autocomplete="current-password"
                          Required="true"
                          RequiredError="Password is required."
                          Disabled="@_isSubmitting"
                          Class="mt-4"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentAriaLabel="@(_showPassword ? "Hide password" : "Show password")"
                          AdornmentColor="Color.Default"
                          OnAdornmentClick="TogglePasswordVisibility" />
            <div class="d-flex justify-end mt-2">
                <MudButton OnClick="@(() => Nav.NavigateTo("/forgot-password"))" Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Style="font-size: 12px;">
                    Forgot password?
                </MudButton>
            </div>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="mt-3"
                       ButtonType="ButtonType.Submit"
                       OnClick="SubmitAsync"
                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    <text>Signing in…</text>
                }
                else
                {
                    <text>Sign in</text>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="ml-1" />
                }
            </MudButton>
        </MudForm>

        <div class="d-flex align-center justify-center gap-2 mt-6">
            <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Color="Color.Secondary" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">Encrypted in transit · JWT-secured session</MudText>
        </div>
    </MudPaper>
</div>

@code {
    private MudForm? _form;
    private string _email = string.Empty;
    private string _password = string.Empty;
    private string _tenant = "root";
    private bool _showPassword;
    private bool _isSubmitting;
    private string? _error;
    private string? _signedOutReason;

    protected override void OnInitialized()
    {
        var token = Nav.TryGetQueryString("signedOut", out string? reason) ? reason : null;
        if (token is not null)
            _signedOutReason = token;
    }

    private void TogglePasswordVisibility() => _showPassword = !_showPassword;

    private async Task SubmitAsync()
    {
        if (_isSubmitting)
        {
            return;
        }

        if (_form is not null)
        {
            await _form.ValidateAsync();
            if (!_form.IsValid)
            {
                return;
            }
        }

        _isSubmitting = true;
        _error = null;
        try
        {
            var result = await AuthService.LoginAsync(_email, _password, _tenant, "admin");
            await AuthStateProvider.NotifyLoginAsync(result.AccessToken, result.RefreshToken, _tenant);
            await PermissionsProvider.InvalidateCache();

            var returnUrl = Nav.TryGetQueryString<string>("returnUrl", out var url) && url is not null ? url : "/";
            Nav.NavigateTo(returnUrl);
        }
        catch (HttpRequestException ex)
        {
            _error = ex.StatusCode is not null
                ? $"Login failed ({(int)ex.StatusCode})"
                : "Unable to connect to server. Please try again.";
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
