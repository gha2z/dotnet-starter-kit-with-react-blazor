@page "/reset-password"
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="d-flex align-center justify-center" style="min-height: 100vh; background: #F0F2F5;">
    <MudPaper Class="pa-8" Style="width: 420px; max-width: 90vw;" Elevation="3">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Set New Password</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-6">
            Enter your new password.
        </MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        @if (_success)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">Password reset successfully.</MudAlert>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" FullWidth="true"
                       OnClick="@(() => Nav.NavigateTo("/login"))">
                Sign In
            </MudButton>
        }
        else
        {
            <MudForm @ref="_form">
                <MudTextField @bind-Value="_email"
                              Label="Email"
                              For="@(() => _email)"
                              Required="true"
                              Disabled="@_isSubmitting" />
                <MudTextField @bind-Value="_token"
                              Label="Reset Token"
                              For="@(() => _token)"
                              Required="true"
                              HelperText="Paste the token from your reset email"
                              Disabled="@_isSubmitting"
                              Class="mt-4" />
                <MudTextField @bind-Value="_password"
                              Label="New Password"
                              For="@(() => _password)"
                              InputType="InputType.Password"
                              Required="true"
                              RequiredError="Password is required."
                              Disabled="@_isSubmitting"
                              Class="mt-4" />
                @if (!string.IsNullOrEmpty(_password))
                {
                    var strength = ScorePassword(_password);
                    <div class="mt-2">
                        <div style="display: flex; gap: 4px; height: 4px;">
                            <div style="flex: 1; border-radius: 2px; background: @(strength switch { "weak" => "var(--mud-palette-error)", "fair" => "var(--mud-palette-warning)", _ => "var(--mud-palette-success)" });"></div>
                            <div style="flex: 1; border-radius: 2px; background: @(strength is "fair" or "strong" ? strength switch { "fair" => "var(--mud-palette-warning)", _ => "var(--mud-palette-success)" } : "var(--mud-palette-lines-default)");"></div>
                            <div style="flex: 1; border-radius: 2px; background: @(strength == "strong" ? "var(--mud-palette-success)" : "var(--mud-palette-lines-default)");"></div>
                        </div>
                        <MudText Typo="Typo.caption" Style="@($"color: {StrengthColor(strength)}")">
                            @StrengthLabel(strength)
                        </MudText>
                    </div>
                }
                <MudTextField @bind-Value="_confirmPassword"
                              Label="Confirm Password"
                              For="@(() => _confirmPassword)"
                              InputType="InputType.Password"
                              Required="true"
                              Disabled="@_isSubmitting"
                              Class="mt-4"
                              Validation="@(new Func<string?, string?>(ConfirmValidation))" />
                <MudTextField @bind-Value="_tenant"
                              Label="Tenant"
                              For="@(() => _tenant)"
                              Disabled="@_isSubmitting"
                              Class="mt-4" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="mt-6"
                           Disabled="@_isSubmitting"
                           OnClick="SubmitAsync">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    }
                    Reset Password
                </MudButton>
            </MudForm>
        }
    </MudPaper>
</div>

@code {
    private MudForm? _form;
    private string _email = string.Empty;
    private string _token = string.Empty;
    private string _password = string.Empty;
    private string _confirmPassword = string.Empty;
    private string _tenant = "root";
    private bool _isSubmitting;
    private bool _success;
    private string? _error;

    protected override void OnInitialized()
    {
        if (Nav.TryGetQueryString("email", out string? email))
            _email = email ?? string.Empty;
        if (Nav.TryGetQueryString("token", out string? token))
            _token = token ?? string.Empty;
        if (Nav.TryGetQueryString("tenant", out string? tenant))
            _tenant = tenant ?? "root";
    }

    private string? ConfirmValidation(string? value)
    {
        if (value != _password)
            return "Passwords don't match.";
        return null;
    }

    private static string ScorePassword(string value)
    {
        if (value.Length < 8) return "weak";
        int score = 0;
        if (System.Text.RegularExpressions.Regex.IsMatch(value, "[a-z]")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(value, "[A-Z]")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(value, "\\d")) score++;
        if (System.Text.RegularExpressions.Regex.IsMatch(value, "[^A-Za-z0-9]")) score++;
        if (value.Length >= 12) score++;
        return score <= 2 ? "weak" : score == 3 ? "fair" : "strong";
    }

    private static string StrengthColor(string strength) => strength switch
    {
        "weak" => "var(--mud-palette-error)",
        "fair" => "var(--mud-palette-warning)",
        _ => "var(--mud-palette-success)"
    };

    private static string StrengthLabel(string strength) => strength switch
    {
        "weak" => "Weak",
        "fair" => "Fair",
        _ => "Strong"
    };

    private async Task SubmitAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid) return;

        _isSubmitting = true;
        _error = null;
        try
        {
            await AuthService.ResetPasswordAsync(_email, _password, _token, _tenant);
            Snackbar.Add("Password reset successfully.", Severity.Success);
            _success = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
