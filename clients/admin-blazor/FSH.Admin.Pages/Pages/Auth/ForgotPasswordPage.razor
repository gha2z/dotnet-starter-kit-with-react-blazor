@page "/forgot-password"
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="d-flex align-center justify-center" style="min-height: 100vh; background: #F0F2F5;">
    <MudPaper Class="pa-8" Style="width: 420px; max-width: 90vw;" Elevation="3">
        <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Reset Password</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-6">
            Enter your email and we&apos;ll send you a reset link.
        </MudText>

        @if (!string.IsNullOrEmpty(_error))
        {
            <MudAlert Severity="Severity.Error" Class="mb-4">@_error</MudAlert>
        }

        @if (_success)
        {
            <MudAlert Severity="Severity.Success" Class="mb-4">
                If an account exists, you&apos;ll receive a password reset email shortly.
            </MudAlert>
            <MudButton Variant="Variant.Text" FullWidth="true" OnClick="@(() => Nav.NavigateTo("/login"))">
                Back to Sign In
            </MudButton>
        }
        else
        {
            <MudForm @ref="_form">
                <MudTextField @bind-Value="_email"
                              Label="Email"
                              For="@(() => _email)"
                              Required="true"
                              RequiredError="Email is required."
                              Disabled="@_isSubmitting" />
                <MudTextField @bind-Value="_tenant"
                              Label="Tenant"
                              For="@(() => _tenant)"
                              Disabled="@_isSubmitting"
                              Class="mt-4" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="mt-6"
                           Disabled="@_isSubmitting"
                           OnClick="SubmitAsync">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    }
                    Send Reset Link
                </MudButton>
            </MudForm>
            <MudButton Variant="Variant.Text" FullWidth="true" Class="mt-4" OnClick="@(() => Nav.NavigateTo("/login"))">
                Back to Sign In
            </MudButton>
        }
    </MudPaper>
</div>

@code {
    private MudForm? _form;
    private string _email = string.Empty;
    private string _tenant = "root";
    private bool _isSubmitting;
    private bool _success;
    private string? _error;

    private async Task SubmitAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid) return;

        _isSubmitting = true;
        _error = null;
        try
        {
            await AuthService.ForgotPasswordAsync(_email, _tenant);
            _success = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
