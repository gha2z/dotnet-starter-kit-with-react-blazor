@page "/billing/invoices"
@attribute [Authorize(Policy = BillingPermissions.View)]
@using FSH.BlazorShared.Formatting
@using FSH.BlazorShared.Models.Billing

<BillingScaffold>
    <div class="row mb-4">
        <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-lg-0">
            <FshKpiTile Label="Page invoices" Value="@_items.Count.ToString()" Loading="@_loading" Footnote="@(_data is null ? "loading…" : $"{_data.TotalCount} total")" />
        </div>
        <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-lg-0">
            <FshKpiTile Label="Billed" Value="@FshFormat.Money(_totalBilled, _currency)" Loading="@_loading" Footnote="this page" />
        </div>
        <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-sm-0">
            <FshKpiTile Label="Outstanding" Value="@FshFormat.Money(_outstanding, _currency)" Loading="@_loading" Footnote="issued, awaiting payment" />
        </div>
        <div class="col-12 col-sm-6 col-lg-3">
            <FshKpiTile Label="Paid" Value="@FshFormat.Money(_paidTotal, _currency)" Loading="@_loading" Footnote="@($"{_paidCount} invoice{(_paidCount == 1 ? string.Empty : "s")}")" />
        </div>
    </div>

    <MudPaper Elevation="1" Class="pa-4 mb-4">
        <div class="d-flex flex-wrap align-center justify-space-between gap-2 mb-3">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@Icons.Material.Filled.FilterAlt" Color="Color.Secondary" Size="Size.Small" />
                <div>
                    <MudText Typo="Typo.subtitle1" Style="margin: 0;">Filters</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin: 0;">
                        All filters are AND-combined. Period is matched exactly (year + month).
                    </MudText>
                </div>
            </div>
            @if (FiltersDirty)
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Clear" OnClick="ClearFiltersAsync">
                    Clear
                </MudButton>
            }
        </div>
        <div class="row">
            <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-sm-0">
                <MudTextField T="string"
                              @bind-Value="_tenantFilter"
                              @bind-Value:after="OnFilterChangedAsync"
                              Label="Tenant"
                              Placeholder="tenant identifier"
                              Clearable="true"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-sm-0">
                <MudSelect T="string"
                           @bind-Value="_statusFilter"
                           @bind-Value:after="OnFilterChangedAsync"
                           Label="Status"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined">
                    <MudSelectItem Value="@string.Empty">All</MudSelectItem>
                    @foreach (var status in Statuses)
                    {
                        <MudSelectItem Value="@status">@status</MudSelectItem>
                    }
                </MudSelect>
            </div>
            <div class="col-12 col-sm-6 col-lg-3 mb-2 mb-sm-0">
                <MudTextField T="string"
                              @bind-Value="_periodYear"
                              @bind-Value:after="OnFilterChangedAsync"
                              Label="Year"
                              Placeholder="2026"
                              InputType="InputType.Number"
                              MaxLength="4"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>
            <div class="col-12 col-sm-6 col-lg-3">
                <MudTextField T="string"
                              @bind-Value="_periodMonth"
                              @bind-Value:after="OnFilterChangedAsync"
                              Label="Month"
                              Placeholder="1–12"
                              InputType="InputType.Number"
                              MaxLength="2"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>
        </div>
    </MudPaper>

    <MudPaper Elevation="1" Class="pa-4 pa-md-6">
        <div class="mb-1">
            <MudText Typo="Typo.h6" Style="margin: 0;">Invoices</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin: 0;">
                @(_data is null ? "Loading…" : $"Page {_data.PageNumber} of {Math.Max(_data.TotalPages, 1)} · {_data.TotalCount} total")
            </MudText>
        </div>

        @if (_error is not null)
        {
            <FshErrorBand Message="@_error" />
        }
        else if (_loading && _items.Count == 0)
        {
            @for (var i = 0; i < 5; i++)
            {
                <div class="d-flex align-center justify-space-between gap-4 py-3" style="border-bottom: 1px solid var(--mud-palette-lines-default);">
                    <div style="flex: 1;">
                        <div class="fsh-skeleton" style="width: 45%; height: 16px;"></div>
                        <div class="fsh-skeleton mt-2" style="width: 70%; height: 12px;"></div>
                    </div>
                    <div class="fsh-skeleton" style="width: 80px; height: 16px;"></div>
                </div>
            }
        }
        else if (_items.Count == 0)
        {
            <FshEmptyState Icon="@Icons.Material.Filled.Receipt"
                           Kicker="// invoices"
                           Title="No invoices found."
                           Description="No invoices match the current filters." />
        }
        else
        {
            @foreach (var inv in _items)
            {
                <div class="d-flex align-center justify-space-between gap-4 py-3 cursor-pointer"
                     style="border-bottom: 1px solid var(--mud-palette-lines-default);"
                     @onclick="@(() => Nav.NavigateTo($"/billing/invoices/{inv.Id}"))">
                    <div class="d-flex align-center gap-3 min-w-0">
                        <FshToneIconTile Icon="@Icons.Material.Filled.Description" TileSize="36px" IconSize="Size.Small" />
                        <div class="min-w-0">
                            <div class="d-flex flex-wrap align-center gap-2">
                                <code class="fsh-code-chip">@inv.InvoiceNumber</code>
                                <FshStatusPill Text="@inv.Status" Tone="@StatusTone(inv.Status)" />
                                <FshStatusPill Text="@inv.Purpose" />
                            </div>
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="font-mono" Style="margin: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                tenant <span style="color: var(--mud-palette-text-primary);">@inv.TenantId</span> ·
                                period @FshFormat.Period(inv.PeriodYear, inv.PeriodMonth) ·
                                created @FshFormat.DateShort(inv.CreatedAtUtc)
                                @if (inv.PaidAtUtc is not null)
                                {
                                    <span> · paid @FshFormat.DateShort(inv.PaidAtUtc)</span>
                                }
                                @if (inv.VoidedAtUtc is not null)
                                {
                                    <span> · voided @FshFormat.DateShort(inv.VoidedAtUtc)</span>
                                }
                            </MudText>
                        </div>
                    </div>
                    <div class="text-right">
                        <MudText Typo="Typo.subtitle1" Class="font-weight-medium tabular-nums" Style="margin: 0;">@FshFormat.Money(inv.SubtotalAmount, inv.Currency)</MudText>
                        @if (inv.DueAtUtc is not null && inv.Status == "Issued")
                        {
                            <MudText Typo="Typo.caption" Class="font-mono" Style="margin: 0; color: var(--mud-palette-warning);">
                                due @FshFormat.DateShort(inv.DueAtUtc)
                            </MudText>
                        }
                    </div>
                </div>
            }
        }

        @if (_data is not null)
        {
            <div class="d-flex justify-end pt-4">
                <FshPager TotalCount="@_data.TotalCount"
                          PageNumber="@_pageNumber"
                          PageSize="PageSize"
                          PageChanged="OnPageChangedAsync" />
            </div>
        }
    </MudPaper>
</BillingScaffold>
