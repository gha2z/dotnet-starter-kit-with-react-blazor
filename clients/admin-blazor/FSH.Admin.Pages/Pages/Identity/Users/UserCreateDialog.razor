@namespace FSH.Admin.Wasm.Pages.Identity.Users

<MudDialog>
    <DialogContent>
        <MudForm @ref="_mudForm" Validation="@(new DataAnnotationsValidator())">
            <MudTextField @bind-Value="_form.FirstName"
                          Label="First name"
                          For="@(() => _form.FirstName)"
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_form.LastName"
                          Label="Last name"
                          For="@(() => _form.LastName)"
                          Class="mt-4"
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_form.UserName"
                          Label="Username"
                          For="@(() => _form.UserName)"
                          HelperText="3-32 characters, starts with a letter. Letters, digits, . _ -"
                          Class="mt-4"
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_form.Email"
                          Label="Email"
                          For="@(() => _form.Email)"
                          Class="mt-4"
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_form.PhoneNumber"
                          Label="Phone number (optional)"
                          For="@(() => _form.PhoneNumber)"
                          Class="mt-4"
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_form.Password"
                          Label="Password"
                          InputType="InputType.Password"
                          For="@(() => _form.Password)"
                          Class="mt-4"
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_form.ConfirmPassword"
                          Label="Confirm password"
                          InputType="InputType.Password"
                          For="@(() => _form.ConfirmPassword)"
                          Class="mt-4"
                          Disabled="@_isSubmitting" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isSubmitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSubmitting" OnClick="SaveAsync">
            @if (_isSubmitting)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Create user
        </MudButton>
    </DialogActions>
</MudDialog>
