@namespace FSH.Admin.Wasm.Pages.Identity.Roles

<MudDialog MaxWidth="MaxWidth.Medium" FullWidth="true">
    <DialogContent>
        <div class="d-flex align-center gap-3 mb-2">
            <FshToneIconTile Icon="@Icons.Material.Filled.Shield" Tone="Color.Primary" TileSize="32px" IconSize="Size.Small" />
            <div>
                <MudText Typo="Typo.subtitle1" Class="font-weight-semibold" Style="margin: 0;">New role</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin: 0;">Roles group users for permission management. Assign roles to control what each team member can do.</MudText>
            </div>
        </div>
        <div style="border-bottom: 1px solid var(--mud-palette-divider); margin-bottom: 16px;"></div>

        <MudForm @ref="_mudForm" Validation="@(new DataAnnotationsValidator())">
            <MudTextField @bind-Value="_form.Name"
                          Label="Name"
                          For="@(() => _form.Name)"
                          HelperText="2-64 characters. The role name is what shows up in user role assignments."
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_form.Description"
                          Label="Description (optional)"
                          For="@(() => _form.Description)"
                          HelperText="Plain English explaining what this role is for."
                          Class="mt-4"
                          Disabled="@_isSubmitting" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="@_isSubmitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_isSubmitting" OnClick="SaveAsync">
            @if (_isSubmitting)
            {
                <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
            }
            Create role
        </MudButton>
    </DialogActions>
</MudDialog>
