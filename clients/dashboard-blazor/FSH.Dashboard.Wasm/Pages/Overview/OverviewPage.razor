@page "/"
@attribute [Authorize]

<FshPageHeader Title="Overview" Description="Your tenant's billing at a glance — plans, invoices, and what's outstanding."
               Icon="@Icons.Material.Filled.Dashboard">
</FshPageHeader>

@if (_error is not null)
{
    <FshErrorBand Message="@_error" />
}

<div class="fsh-enter">
    <MudGrid>
        <MudItem xs="12" sm="6" xl="3">
            <FshStatTile Label="Plans" Value="@Display(_planTotal)" Hint="@(_planTotal is null ? "loading." : $"{_activePlans} active")" />
        </MudItem>
        <MudItem xs="12" sm="6" xl="3">
            <FshStatTile Label="Invoices" Value="@Display(_invoiceTotal)" Hint="@(_invoiceTotal is null ? "loading." : $"{_invoiceLedgerTotal} total ledger")" />
        </MudItem>
        <MudItem xs="12" sm="6" xl="3">
            <FshStatTile Label="Outstanding" Value="@Display(_outstandingCount)" Hint="issued, awaiting payment"
                         Tone="@(_outstandingCount > 0 ? Color.Warning : Color.Inherit)" />
        </MudItem>
    </MudGrid>
</div>
