<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>FSH.Dashboard.Wasm</RootNamespace>
    <AssemblyName>FSH.Dashboard.Wasm</AssemblyName>
    <BlazorWebAssemblyLoadAllGlobalizationData>true</BlazorWebAssemblyLoadAllGlobalizationData>
    <BlazorWebAssemblyEnableTrimming>true</BlazorWebAssemblyEnableTrimming>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" Version="10.0.10" PrivateAssets="all" />
    <PackageReference Include="MudBlazor" Version="9.7.0" />
    <PackageReference Include="Microsoft.AspNetCore.Components.Authorization" Version="10.0.10" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <BlazorWebAssemblyLazyLoad Include="FSH.Dashboard.Pages.wasm" />
    <TrimmerRootAssembly Include="FSH.Dashboard.Pages" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\FSH.Dashboard.Pages\FSH.Dashboard.Pages.csproj" />
    <ProjectReference Include="..\..\BlazorShared\FSH.BlazorShared.csproj" />
  </ItemGroup>

</Project>
