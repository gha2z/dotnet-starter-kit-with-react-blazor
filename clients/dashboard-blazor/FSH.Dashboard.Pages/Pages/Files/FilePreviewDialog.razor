@using FSH.BlazorShared.Models.Files
@using FSH.BlazorShared.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Forms

@* React parity (components/file/file-preview-dialog.tsx): metadata-first single-column
   preview card. Actions are gated on the UPLOADER (CreatedByUserId), not ownerType —
   the old ownerType=="MyFiles" gate hid delete/flip for files the user uploaded under
   another owner type. Delete is a two-step inline confirm; visibility is a Switch. *@
<MudDialog>
    <DialogContent>
        @if (_meta is null)
        {
            <div class="d-flex align-center gap-2 mb-1">
                <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Size="Size.Small" Color="Color.Secondary" />
                <MudText Typo="Typo.subtitle1" Style="margin: 0; font-weight: 600;">File</MudText>
            </div>
            <div class="fsh-file-preview-skeleton">
                <MudProgressCircular Indeterminate="true" Size="Size.Small" />
            </div>
        }
        else
        {
            <div class="d-flex align-center gap-2 mb-1 min-w-0">
                <MudIcon Icon="@MimeIcon" Size="Size.Small" Color="Color.Secondary" Class="flex-shrink-0" />
                <MudText Typo="Typo.subtitle1" Class="fsh-truncate" Style="margin: 0; font-weight: 600;">@_meta.OriginalFileName</MudText>
            </div>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3" Style="display: block;">
                @_meta.ContentType · @FormatBytes(_meta.SizeBytes)
            </MudText>

            @if (_metaError is not null)
            {
                <FshErrorBand Message="@_metaError" />
            }
            else if (_meta.Status != FileAssetStatus.Available)
            {
                <div class="fsh-file-preview-note">
                    @(_meta.Status == FileAssetStatus.PendingUpload
                        ? "Upload not yet finalized."
                        : "This file is quarantined and cannot be previewed.")
                </div>
            }
            else if (_meta.ContentType.StartsWith("image/"))
            {
                if (_urlErrored)
                {
                    <div class="fsh-file-preview-note">
                        <span>Preview link expired or unreachable.</span>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-2" OnClick="RetryUrlAsync">Retry</MudButton>
                    </div>
                }
                else if (string.IsNullOrEmpty(_previewUrl))
                {
                    <div class="fsh-file-preview-skeleton">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    </div>
                }
                else
                {
                    <div class="fsh-file-preview-frame">
                        <img src="@_previewUrl" alt="@_meta.OriginalFileName" referrerpolicy="no-referrer" @onerror="OnPreviewError" />
                    </div>
                }
            }
            else if (_meta.ContentType == "application/pdf" && !string.IsNullOrEmpty(_previewUrl))
            {
                <iframe src="@_previewUrl" title="@_meta.OriginalFileName" class="fsh-file-preview-pdf"></iframe>
            }
            else if (_meta.ContentType.StartsWith("text/"))
            {
                if (string.IsNullOrEmpty(_previewUrl))
                {
                    <div class="fsh-file-preview-skeleton">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" />
                    </div>
                }
                else
                {
                    <TextPreviewBlock Url="@_previewUrl" />
                }
            }
            else
            {
                <div class="fsh-file-preview-note">
                    <MudIcon Icon="@Icons.Material.Outlined.InsertDriveFile" Size="Size.Large" Color="Color.Secondary" Style="font-size: 56px;" />
                    <span class="mt-2">Preview not available for this file type.</span>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.OpenInNew" Class="mt-3" OnClick="DownloadAsync">
                        Open in new tab
                    </MudButton>
                </div>
            }

            @* Metadata card — visibility row (Switch for the uploader, Read-only badge
               otherwise) + detail rows. *@
            <div class="fsh-file-meta-card mt-4">
                <div class="fsh-file-meta-visibility">
                    <div class="min-w-0">
                        <div class="fsh-mono-label">Visibility</div>
                        <div class="fsh-file-meta-visibility-value @(_isPublic ? "is-public" : "")">
                            @(_isPublic ? "Public" : "Private")
                        </div>
                        <p class="fsh-muted-copy" style="font-size: 11px; margin: 2px 0 0;">
                            @(_isPublic
                                ? "Everyone in your tenant can find this file under Shared."
                                : "Only you can preview or download this file.")
                        </p>
                    </div>
                    @if (_isUploader)
                    {
                        <MudSwitch T="bool" Value="_isPublic" Color="Color.Primary"
                                   Disabled="@_working" aria-label="Toggle public visibility"
                                   ValueChanged="@(async (bool v) => await FlipVisibilityAsync(v))" />
                    }
                    else
                    {
                        <span class="fsh-readonly-badge">Read-only</span>
                    }
                </div>
                <dl class="fsh-file-meta-rows">
                    <div><dt>File ID</dt><dd class="fsh-truncate" title="@_meta.Id" style="font-family: var(--fsh-mono, monospace); font-size: 11px;">@_meta.Id</dd></div>
                    <div><dt>Owner type</dt><dd>@_meta.OwnerType</dd></div>
                    <div><dt>Uploaded by</dt><dd class="fsh-truncate" title="@_meta.CreatedByUserId">@(string.IsNullOrEmpty(_meta.CreatedByUserId) ? "—" : _meta.CreatedByUserId)</dd></div>
                    <div><dt>Content type</dt><dd class="fsh-truncate">@_meta.ContentType</dd></div>
                    <div><dt>Size</dt><dd>@FormatBytes(_meta.SizeBytes)</dd></div>
                    <div><dt>Status</dt><dd>@StatusLabel</dd></div>
                    <div><dt>Created</dt><dd>@FshFormat.DateTimeShort(_meta.CreatedAtUtc)</dd></div>
                </dl>
            </div>
        }
    </DialogContent>
    <DialogActions>
        <div class="d-flex align-center gap-2 fsh-file-preview-actions" style="width: 100%;">
        @if (_meta is not null && _isUploader && _metaError is null)
        {
            if (_confirmingDelete)
            {
                <div class="d-flex align-center gap-2">
                    <span class="fsh-muted-copy" style="font-size: 12px;">Delete this file?</span>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="_working" OnClick="() => _confirmingDelete = false">Cancel</MudButton>
                    <MudButton Variant="Variant.Filled" Color="Color.Error" Size="Size.Small" Disabled="_working" OnClick="ConfirmDeleteAsync">
                        @(_working ? "Deleting…" : "Confirm delete")
                    </MudButton>
                </div>
            }
            else
            {
                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error"
                           StartIcon="@Icons.Material.Outlined.Delete" Disabled="_working"
                           OnClick="() => _confirmingDelete = true">Delete</MudButton>
                <MudSpacer />
            }
        }
        else
        {
            <MudSpacer />
        }
        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Outlined.Download"
                   Disabled="@(_meta is null || _meta.Status != FileAssetStatus.Available || _working)"
                   OnClick="DownloadAsync">Download</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" OnClick="Close">Close</MudButton>
        </div>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private IFileService FileService { get; set; } = default!;
    [Inject] private IJSRuntime JS { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private AuthenticationStateProvider Auth { get; set; } = default!;

    [Parameter] public FileAssetDto File { get; set; } = default!;
    [Parameter] public EventCallback OnChanged { get; set; }

    private FileAssetDto? _meta;
    private string? _previewUrl;
    private string? _currentUserId;
    private bool _isPublic;
    private bool _isUploader;
    private bool _working;
    private bool _confirmingDelete;
    private bool _urlErrored;
    private string? _metaError;

    private string MimeIcon =>
        _meta is null ? Icons.Material.Outlined.InsertDriveFile
        : _meta.ContentType.StartsWith("image/") ? Icons.Material.Outlined.Image
        : _meta.ContentType.StartsWith("text/") || _meta.ContentType == "application/pdf" ? Icons.Material.Outlined.Description
        : _meta.ContentType.Contains("zip") || _meta.ContentType.Contains("compressed") ? Icons.Material.Outlined.FolderZip
        : Icons.Material.Outlined.InsertDriveFile;

    private string StatusLabel => _meta?.Status switch
    {
        FileAssetStatus.PendingUpload => "Pending upload",
        FileAssetStatus.Available => "Available",
        FileAssetStatus.Quarantined => "Quarantined",
        _ => "Unknown",
    };

    protected override async Task OnInitializedAsync()
    {
        _meta = File;
        _isPublic = _meta.Visibility == FileVisibility.Public;

        try
        {
            var state = await Auth.GetAuthenticationStateAsync();
            _currentUserId = state.User.FindFirst("sub")?.Value ?? string.Empty;
        }
        catch
        {
            // Auth state unavailable — treat as non-uploader (read-only preview).
        }

        // React parity: refetch metadata on every open — the list may be stale and
        // private files need a FRESH presigned URL each time (they expire).
        try
        {
            _meta = await FileService.GetFileMetadataAsync(_meta.Id);
            _isPublic = _meta.Visibility == FileVisibility.Public;
        }
        catch (Exception ex)
        {
            _metaError = $"Couldn't load file metadata: {ex.Message}";
            StateHasChanged();
            return;
        }

        _isUploader = !string.IsNullOrEmpty(_currentUserId)
            && string.Equals(_meta.CreatedByUserId, _currentUserId, StringComparison.OrdinalIgnoreCase);

        await ResolvePreviewUrlAsync();
    }

    private async Task ResolvePreviewUrlAsync()
    {
        _urlErrored = false;
        if (_meta is null)
        {
            return;
        }

        if (_isPublic && !string.IsNullOrEmpty(_meta.PublicUrl))
        {
            _previewUrl = _meta.PublicUrl;
            StateHasChanged();
            return;
        }

        var previewable = _meta.ContentType.StartsWith("image/")
            || _meta.ContentType == "application/pdf"
            || _meta.ContentType.StartsWith("text/");
        if (!previewable)
        {
            _previewUrl = null;
            return;
        }

        try
        {
            var url = await FileService.GetFileDownloadUrlAsync(_meta.Id, inline: true);
            _previewUrl = url.Url.ToString();
        }
        catch
        {
            _previewUrl = null;
        }
        StateHasChanged();
    }

    private async Task RetryUrlAsync()
    {
        _urlErrored = false;
        await ResolvePreviewUrlAsync();
    }

    private void OnPreviewError()
    {
        _urlErrored = true;
        StateHasChanged();
    }

    private async Task FlipVisibilityAsync(bool makePublic)
    {
        if (_meta is null || _working)
        {
            return;
        }

        _working = true;
        try
        {
            _meta = await FileService.ChangeVisibilityAsync(_meta.Id, makePublic ? FileVisibility.Public : FileVisibility.Private);
            _isPublic = _meta.Visibility == FileVisibility.Public;
            Snackbar.Add(_isPublic ? "File is now public to your tenant" : "File is now private", Severity.Success);
            _previewUrl = null;
            await ResolvePreviewUrlAsync();
            await OnChanged.InvokeAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Visibility change failed: {ex.Message}", Severity.Error);
        }
        finally { _working = false; }
    }

    private async Task ConfirmDeleteAsync()
    {
        if (_meta is null || _working)
        {
            return;
        }

        _working = true;
        try
        {
            await FileService.DeleteAsync(_meta.Id);
            Snackbar.Add("File deleted", Severity.Success);
            await OnChanged.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
            _confirmingDelete = false;
            _working = false;
        }
    }

    private async Task DownloadAsync()
    {
        if (_meta is null)
        {
            return;
        }

        try
        {
            var url = await FileService.GetFileDownloadUrlAsync(_meta.Id);
            await JS.InvokeVoidAsync("fshOpenDownload", url.Url.ToString());
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Download failed: {ex.Message}", Severity.Error);
        }
    }

    private void Close() => MudDialog.Close();

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        < 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024):F1} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):F2} GB"
    };
}
