@page "/files"
@using FSH.BlazorShared.Formatting
@using FSH.BlazorShared.Permissions
@attribute [Authorize]

<FshPageHeader Icon="@Icons.Material.Outlined.FolderOpen" Title="Files"
               Count="@(_loading ? null : _myFiles.Count)" Unit="file"
               Description="Drop images, documents, or archives. Uploads are private to you by default; flip a file to public from its preview to make it visible to the rest of the tenant under Shared." />

@* React parity (my-files.tsx): rounded tab pills — My files carries a count badge. *@
<div class="d-flex gap-2 mb-4">
    <MudButton Variant="@(_activeTab == 0 ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
               Size="Size.Small" Class="fsh-file-tab rounded-pill" StartIcon="@Icons.Material.Outlined.Folder"
               OnClick="() => SwitchTab(0)">
        My files @if (_myFiles.Count > 0)
        {
            <span class="fsh-file-tab-count">@_myFiles.Count</span>
        }
    </MudButton>
    <MudButton Variant="@(_activeTab == 1 ? Variant.Filled : Variant.Outlined)" Color="Color.Primary"
               Size="Size.Small" Class="fsh-file-tab rounded-pill" StartIcon="@Icons.Material.Outlined.People"
               OnClick="() => SwitchTab(1)">
        Shared in tenant
    </MudButton>
</div>

@if (_activeTab == 0)
{
    @* Upload zone — React parity: centered compact zone, whole area clickable. *@
    <MudPaper Class="@($"fsh-file-dropzone pa-8 mb-4 text-center{(_dragOver ? " dragover" : string.Empty)}")" Elevation="0">
        <div id="fsh-dropzone" class="fsh-file-dropzone-inner" @onclick="OpenFilePicker" @ondragenter="OnDragEnter" @ondragenter:preventDefault
             @ondragleave="OnDragLeave"
             @ondragover:preventDefault
             @ondrop="HandleDrop" @ondrop:preventDefault>
            <InputFile id="fileInput" OnChange="HandleFileSelect" multiple accept="@_acceptTypes" style="display:none;" />
            <span class="fsh-upload-tile">
                <MudIcon Icon="@Icons.Material.Outlined.CloudUpload" Size="Size.Small" />
            </span>
            <MudText Typo="Typo.body1" Class="mt-3" Style="font-weight: 500;">Drop a file or click to browse</MudText>
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                Allowed: jpg, jpeg, png, webp, gif, ico, pdf, docx, xlsx, pptx, txt, csv, zip · up to 50.0 MB
            </MudText>
            @if (_uploading)
            {
                <MudProgressLinear Value="_uploadProgress" Color="Color.Primary" Class="mt-3" Striped Style="max-width: 420px; margin-left: auto; margin-right: auto;" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@_uploadStatus</MudText>
            }
        </div>
    </MudPaper>
}

@* Filter bar — React parity: search left, type pills with counts right. *@
<div class="d-flex align-center gap-2 mb-3 flex-wrap justify-space-between">
    <MudTextField @bind-Value="_search" Placeholder="Search by filename..." Adornment="Adornment.Start"
                  AdornmentIcon="@Icons.Material.Outlined.Search" IconSize="Size.Small" Immediate="true"
                  DebounceInterval="300" OnDebounceIntervalElapsed="LoadFiles"
                  Margin="Margin.Dense" Variant="Variant.Outlined" Style="max-width: 340px;" Class="flex-grow-1" />
    <div class="d-flex gap-1 flex-wrap">
        @foreach (var filter in _typeFilters)
        {
            var count = TypeCount(filter);
            <MudChip T="string" Size="Size.Small" Variant="@(filter == _activeFilter ? Variant.Filled : Variant.Outlined)"
                     Color="@(filter == _activeFilter ? Color.Primary : Color.Default)"
                     OnClick="() => SetFilter(filter)">@filter @if (count > 0)
            {
                <span style="opacity: 0.65;">@count</span>
            }
            </MudChip>
        }
    </div>
</div>

@* File list *@
@if (_loading)
{
    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="d-flex mx-auto my-4" />
}
else if (FilteredFiles.Count == 0)
{
    <FshEmptyState Icon="@Icons.Material.Outlined.FolderOff"
                   Title="@(_activeTab == 0 ? "No files uploaded yet" : "No shared files")"
                   Description="@(_activeTab == 0 ? "Drop a file above to get started. Uploads stay private until you flip them to public." : "Files flipped to public by any tenant member appear here.")" />
}
else
{
    <p class="fsh-muted-copy mb-2" style="font-size: 12px; font-weight: 500;">@FilteredFiles.Count file@(FilteredFiles.Count == 1 ? "" : "s")</p>
    <MudTable Items="@FilteredFiles" Hover="true" Breakpoint="Breakpoint.Sm" Dense="true" RowsPerPage="20"
              T="FileAssetDto" OnRowClick="@(e => e.Item is null ? Task.CompletedTask : PreviewFile(e.Item))" Style="cursor: pointer;">
        <HeaderContent>
            <MudTh>Filename</MudTh>
            <MudTh>Visibility</MudTh>
            <MudTh>Size</MudTh>
            <MudTh>Uploaded</MudTh>
            <MudTh Class="text-right"></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="Filename">
                <div class="d-flex align-center gap-3">
                    <span class="fsh-file-icon-tile">
                        <MudIcon Icon="@FileIcon(context.ContentType)" Size="Size.Small" />
                    </span>
                    <MudText Typo="Typo.body2" Style="overflow:hidden;text-overflow:ellipsis;white-space:nowrap;max-width:420px;">
                        @context.OriginalFileName
                    </MudText>
                </div>
            </MudTd>
            <MudTd DataLabel="Visibility">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                         Color="@(context.Visibility == FileVisibility.Public ? Color.Info : Color.Default)">
                    @(context.Visibility == FileVisibility.Public ? "Public" : "Private")
                </MudChip>
            </MudTd>
            <MudTd DataLabel="Size" Style="font-variant-numeric: tabular-nums;">@FormatBytes(context.SizeBytes)</MudTd>
            <MudTd DataLabel="Uploaded">@FshFormat.DateShort(context.CreatedAtUtc)</MudTd>
            <MudTd Class="text-right">
                <MudIcon Icon="@Icons.Material.Outlined.ChevronRight" Size="Size.Small" Color="Color.Default" />
            </MudTd>
        </RowTemplate>
        <PagerContent>
            <MudTablePager />
        </PagerContent>
    </MudTable>
}

@code {
    [Inject] private IFileService FileService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;
    [Inject] private IDialogService DialogService { get; set; } = default!;

    private int _activeTab;
    private readonly List<FileAssetDto> _myFiles = [];
    private readonly List<FileAssetDto> _sharedFiles = [];
    private string? _search;
    private bool _loading;
    private bool _uploading;
    private double _uploadProgress;
    private string _uploadStatus = string.Empty;
    private int _dragDepth;
    private bool _dragOver;

    private const string _acceptTypes = ".jpg,.jpeg,.png,.gif,.webp,.pdf,.doc,.docx,.xls,.xlsx,.txt,.zip,.rar";

    private readonly string[] _typeFilters = ["All", "Images", "Documents", "Archives"];
    private string _activeFilter = "All";

    /// <summary>React parity (my-files.tsx): type pills carry per-type counts.</summary>
    private int TypeCount(string filter) => (_activeTab == 0 ? _myFiles : _sharedFiles).Count(f => filter switch
    {
        "Images" => f.ContentType.StartsWith("image/"),
        "Documents" => f.ContentType is "application/pdf" or "application/msword" or "application/vnd.openxmlformats-officedocument.wordprocessingml.document" or "application/vnd.ms-excel" or "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" or "text/plain",
        "Archives" => f.ContentType is "application/zip" or "application/x-rar-compressed",
        _ => true
    });

    private void SwitchTab(int tab)
    {
        _activeTab = tab;
        _activeFilter = "All";
    }

    private IReadOnlyList<FileAssetDto> FilteredFiles => (_activeTab == 0 ? _myFiles : _sharedFiles)
        .Where(f => _activeFilter switch
        {
            "Images" => f.ContentType.StartsWith("image/"),
            "Documents" => f.ContentType is "application/pdf" or "application/msword" or "application/vnd.openxmlformats-officedocument.wordprocessingml.document" or "application/vnd.ms-excel" or "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet" or "text/plain",
            "Archives" => f.ContentType is "application/zip" or "application/x-rar-compressed",
            _ => true
        })
        .Where(f => string.IsNullOrWhiteSpace(_search) || f.OriginalFileName.Contains(_search, StringComparison.OrdinalIgnoreCase))
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadFiles();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await JS.InvokeVoidAsync("fshInitDropCapture", "fsh-dropzone");
        }
    }

    private async Task LoadFiles()
    {
        _loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var myTask = FileService.ListMyFilesAsync(pageSize: 100);
            var sharedTask = FileService.ListSharedFilesAsync(pageSize: 100);
            await Task.WhenAll(myTask, sharedTask);

            _myFiles.Clear();
            _myFiles.AddRange(myTask.Result.OrderByDescending(f => f.CreatedAtUtc));

            _sharedFiles.Clear();
            _sharedFiles.AddRange(sharedTask.Result.OrderByDescending(f => f.CreatedAtUtc));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to load files: {ex.Message}", Severity.Error);
        }

        _loading = false;
    }

    private void SetFilter(string filter) { _activeFilter = filter; }

    private void OpenFilePicker() => JS.InvokeVoidAsync("fshOpenFilePicker", "fileInput");

    private async Task HandleFileSelect(InputFileChangeEventArgs e)
    {
        foreach (var file in e.GetMultipleFiles())
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 100 * 1024 * 1024);
            using var ms = new MemoryStream();
            await stream.CopyToAsync(ms);
            await UploadFileCore(file.Name, file.ContentType, file.Size, ms.ToArray());
        }
    }

    private void OnDragEnter() { _dragDepth++; _dragOver = true; }

    private void OnDragLeave() { _dragDepth = Math.Max(0, _dragDepth - 1); _dragOver = _dragDepth > 0; }

    private async Task HandleDrop(DragEventArgs e)
    {
        _dragDepth = 0;
        _dragOver = false;

        var dropped = await JS.InvokeAsync<List<DroppedFileInfo>>("fshGetDroppedFiles") ?? [];
        for (var i = 0; i < dropped.Count; i++)
        {
            var bytes = await JS.InvokeAsync<byte[]>("fshReadDroppedFile", i, 100 * 1024 * 1024);
            if (bytes is null || bytes.Length == 0)
            {
                continue;
            }

            var info = dropped[i];
            await UploadFileCore(
                info.Name,
                string.IsNullOrWhiteSpace(info.Type) ? "application/octet-stream" : info.Type,
                info.Size,
                bytes);
        }
    }

    private async Task UploadFileCore(string name, string contentType, long size, byte[] bytes)
    {
        _uploading = true;
        _uploadProgress = 0;
        _uploadStatus = $"Uploading {name}...";
        await InvokeAsync(StateHasChanged);

        try
        {
            // Step 1: Request presigned URL
            var category = CategoryFor(name);
            var uploadResponse = await FileService.RequestUploadUrlAsync(new RequestUploadUrlRequest(
                OwnerType: "MyFiles",
                OwnerId: null,
                FileName: name,
                ContentType: contentType,
                SizeBytes: size,
                Category: category));

            // Step 2: Upload directly to S3 via JS interop (PUT presigned URL)
            _uploadProgress = 50;
            _uploadStatus = "Uploading to storage...";
            await InvokeAsync(StateHasChanged);

            await JS.InvokeVoidAsync("fshFileUpload", uploadResponse.UploadUrl.ToString(), bytes, uploadResponse.RequiredHeaders);

            // Step 3: Finalize
            _uploadProgress = 90;
            _uploadStatus = "Finalizing...";
            await InvokeAsync(StateHasChanged);

            await FileService.FinalizeUploadAsync(uploadResponse.FileAssetId);

            _uploadProgress = 100;
            _uploadStatus = "Upload complete!";
            Snackbar.Add($"{name} uploaded successfully!", Severity.Success);
            await LoadFiles();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }

        _uploading = false;
        await InvokeAsync(StateHasChanged);
    }

    private async Task PreviewFile(FileAssetDto file)
    {
        var parameters = new DialogParameters<FilePreviewDialog>();
        parameters.Add(d => d.File, file);
        parameters.Add(d => d.OnChanged, EventCallback.Factory.Create(this, LoadFiles));
        // The dialog renders its own header (mime icon + name + type·size) — an empty
        // ShowAsync title avoids the double-title bar; CloseButton=true keeps the X.
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large };
        await DialogService.ShowAsync<FilePreviewDialog>(string.Empty, parameters, options);
    }

    private async Task DownloadFile(FileAssetDto file)
    {
        try
        {
            var url = await FileService.GetFileDownloadUrlAsync(file.Id);
            await JS.InvokeVoidAsync("fshOpenDownload", url.Url.ToString());
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Download failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteFile(FileAssetDto file)
    {
        var parameters = new DialogParameters
        {
            { "Message", $"Are you sure you want to delete \"{file.OriginalFileName}\"?" },
            { "ConfirmText", "Delete" },
            { "CancelText", "Cancel" },
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<FSH.BlazorShared.Components.FshConfirmDialogContent>("Delete File", parameters, options);
        var result = await dialog.Result;
        if (result is not null && !result.Canceled)
        {
            try
            {
                await FileService.DeleteAsync(file.Id);
                Snackbar.Add($"{file.OriginalFileName} deleted.", Severity.Info);
                await LoadFiles();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Delete failed: {ex.Message}", Severity.Error);
            }
        }
    }

    private static string CategoryFor(string fileName) => Path.GetExtension(fileName).ToLowerInvariant() switch
    {
        ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".ico" => "Image",
        ".pdf" or ".doc" or ".docx" or ".xls" or ".xlsx" or ".pptx" or ".txt" or ".csv" => "Document",
        ".zip" or ".rar" => "Archive",
        _ => "Document"
    };

    private static string FileIcon(string contentType) => contentType switch
    {
        var ct when ct.StartsWith("image/") => Icons.Material.Outlined.Image,
        "application/pdf" => Icons.Material.Outlined.PictureAsPdf,
        var ct when ct.Contains("word") => Icons.Material.Outlined.Description,
        var ct when ct.Contains("excel") || ct.Contains("spreadsheet") => Icons.Material.Outlined.TableChart,
        "text/plain" => Icons.Material.Outlined.TextSnippet,
        var ct when ct.Contains("zip") || ct.Contains("rar") => Icons.Material.Outlined.FolderZip,
        _ => Icons.Material.Outlined.InsertDriveFile,
    };

    private static string FormatBytes(long bytes) => bytes switch
    {
        < 1024 => $"{bytes} B",
        < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
        < 1024 * 1024 * 1024 => $"{bytes / (1024.0 * 1024):F1} MB",
        _ => $"{bytes / (1024.0 * 1024 * 1024):F2} GB"
    };

    [Inject] private IJSRuntime JS { get; set; } = default!;

    public sealed record DroppedFileInfo(string Name, string Type, long Size);
}
