@page "/settings/branding"
@attribute [Authorize]
@layout SettingsLayout

<FshPageHeader Title="Branding" Icon="@Icons.Material.Filled.Brush"
               Description="Tenant colours and logos." />

<MudPaper Class="pa-6" Elevation="0" Outlined="true">
    <MudStack AlignItems="AlignItems.Center" Class="py-10">
        <MudIcon Icon="@Icons.Material.Filled.Brush" Size="Size.Large" Color="Color.Default" />
        <MudText Typo="Typo.h6">Branding settings aren't available yet.</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary text-center" Style="max-width: 380px;">
            Tenant-wide theme and logo management is on the v1.1 roadmap.
            For now, your tenant admin can manage branding through the operator console.
        </MudText>
    </MudStack>
</MudPaper>
