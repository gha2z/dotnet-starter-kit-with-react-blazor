@page "/settings/api-keys"
@attribute [Authorize]
@layout SettingsLayout

<FshPageHeader Title="API keys" Icon="@Icons.Material.Filled.Key"
               Description="Personal access tokens." />

<MudPaper Class="pa-6" Elevation="0" Outlined="true">
    <MudStack AlignItems="AlignItems.Center" Class="py-10">
        <MudIcon Icon="@Icons.Material.Filled.Key" Size="Size.Large" Color="Color.Default" />
        <MudText Typo="Typo.h6">API keys aren't available yet.</MudText>
        <MudText Typo="Typo.body2" Class="mud-text-secondary text-center" Style="max-width: 380px;">
            Personal access tokens and service-to-service API keys are on the
            v1.1 roadmap. For now, your access flows through the user-bound JWT
            issued at sign-in.
        </MudText>
    </MudStack>
</MudPaper>
