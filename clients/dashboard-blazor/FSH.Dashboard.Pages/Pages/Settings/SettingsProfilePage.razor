@page "/settings/profile"
@attribute [Authorize]
@using FSH.BlazorShared.Models.Identity
@using FSH.BlazorShared.Services
@inject IUserService UserService
@inject ISnackbar Snackbar

<SettingsLayout>
<FshPageHeader Title="Profile" Icon="@Icons.Material.Filled.AccountCircle"
               Description="Your identity across the tenant." />

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else if (_error is not null)
{
    <FshErrorBand Message="@_error" />
}
else if (_profile is not null)
{
    <MudPaper Class="pa-6 mb-4" Elevation="0" Outlined="true">
        <div class="d-flex align-center gap-3 mb-3">
            <FshToneIconTile Icon="@Icons.Material.Filled.CameraAlt" Tone="Color.Primary" TileSize="40px" IconSize="Size.Small" />
            <div>
                <MudText Typo="Typo.subtitle1" Class="font-weight-medium" Style="margin: 0;">Photo</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Shown in the topbar and on your activity. Square crops work best — JPG, PNG, or WebP.</MudText>
            </div>
        </div>
        <div class="d-flex align-center gap-3">
            @if (!string.IsNullOrEmpty(_profile.ImageUrl))
            {
                <img src="@_profile.ImageUrl" alt="Profile avatar" class="fsh-avatar-lg" />
            }
            else
            {
                <FshMonogram Name="@DisplayName" PixelSize="56" />
            }
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit"
                       Disabled="@_savingImage" OnClick="OpenImageDialog">
                Change avatar
            </MudButton>
            @if (!string.IsNullOrEmpty(_profile.ImageUrl))
            {
                <MudButton Variant="Variant.Text" Size="Size.Small" Disabled="@_savingImage" OnClick="ClearImageAsync">
                    Clear
                </MudButton>
            }
        </div>
    </MudPaper>

    <MudPaper Class="pa-6" Elevation="0" Outlined="true">
        <MudGrid>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="First name" @bind-Value="_firstName" Immediate="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Last name" @bind-Value="_lastName" Immediate="true" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Email" Value="@_profile.Email" ReadOnly="true" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    Contact your tenant admin to change your sign-in email.
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField T="string" Label="Phone number" @bind-Value="_phoneNumber" Immediate="true" Placeholder="+1 (555) 123-4567" />
            </MudItem>
            <MudItem xs="12">
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Subject ID: <code>@_profile.Id</code>
                </MudText>
            </MudItem>
            <MudItem xs="12" Class="d-flex justify-end gap-2">
                <MudButton Variant="Variant.Text" OnClick="ResetForm" Disabled="@_saving">Reset</MudButton>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveAsync"
                           Disabled="@(_saving || !_dirty)">
                    @(_saving ? "Saving…" : "Save changes")
                </MudButton>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <MudDialog @bind-Visible="_imageDialogOpen" Options="new DialogOptions { FullWidth = true, MaxWidth = MaxWidth.Small }">
        <DialogContent>
            <MudTextField Label="Image URL" @bind-Value="_imageUrl" Immediate="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
        </DialogContent>
        <DialogActions>
            <MudButton Variant="Variant.Text" OnClick="CloseImageDialog">Cancel</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_savingImage" OnClick="SaveImageAsync">
                @(_savingImage ? "Saving…" : "Save")
            </MudButton>
        </DialogActions>
    </MudDialog>
}

@code {
    private UserDto? _profile;
    private string _firstName = "";
    private string _lastName = "";
    private string _phoneNumber = "";
    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private bool _imageDialogOpen;
    private bool _savingImage;
    private string _imageUrl = "";

    private string DisplayName
    {
        get
        {
            if (_profile is null)
            {
                return "Account";
            }

            var name = string.Join(' ', new[] { _profile.FirstName, _profile.LastName })
                .Trim();
            return !string.IsNullOrEmpty(name) ? name : (_profile.Email ?? "Account");
        }
    }

    private bool _dirty =>
        _profile is not null && (
            (_profile.FirstName ?? "") != _firstName ||
            (_profile.LastName ?? "") != _lastName ||
            (_profile.PhoneNumber ?? "") != _phoneNumber);

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _profile = await UserService.GetMyProfileAsync();
            _firstName = _profile.FirstName ?? "";
            _lastName = _profile.LastName ?? "";
            _phoneNumber = _profile.PhoneNumber ?? "";
        }
        catch (Exception ex)
        {
            _error = $"Failed to load profile: {ex.Message}";
        }
        finally
        {
            _loading = false;
        }
    }

    private void ResetForm()
    {
        if (_profile is null) return;
        _firstName = _profile.FirstName ?? "";
        _lastName = _profile.LastName ?? "";
        _phoneNumber = _profile.PhoneNumber ?? "";
    }

    private async Task SaveAsync()
    {
        _saving = true;
        try
        {
            var request = new UpdateProfileRequest(
                string.IsNullOrWhiteSpace(_firstName) ? null : _firstName.Trim(),
                string.IsNullOrWhiteSpace(_lastName) ? null : _lastName.Trim(),
                string.IsNullOrWhiteSpace(_phoneNumber) ? null : _phoneNumber.Trim());
            _profile = await UserService.UpdateMyProfileAsync(request);
            Snackbar.Add("Profile saved.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Save failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _saving = false;
        }
    }

    private void OpenImageDialog()
    {
        _imageUrl = _profile?.ImageUrl ?? string.Empty;
        _imageDialogOpen = true;
    }

    private void CloseImageDialog() => _imageDialogOpen = false;

    private async Task SaveImageAsync()
    {
        _savingImage = true;
        try
        {
            await UserService.SetProfileImageAsync(string.IsNullOrWhiteSpace(_imageUrl) ? null : _imageUrl.Trim());
            _imageDialogOpen = false;
            Snackbar.Add("Profile image updated", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update profile image: {ex.Message}", Severity.Error);
        }
        finally
        {
            _savingImage = false;
        }
    }

    private async Task ClearImageAsync()
    {
        try
        {
            await UserService.SetProfileImageAsync(null);
            Snackbar.Add("Profile image cleared", Severity.Success);
            await LoadAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to clear profile image: {ex.Message}", Severity.Error);
        }
    }
}
</SettingsLayout>
