<style>
    .fsh-settings-pill-active {
        background: color-mix(in srgb, var(--mud-palette-primary) 12%, transparent) !important;
        color: var(--mud-palette-primary) !important;
        border-color: var(--mud-palette-primary) !important;
    }
</style>

@using Microsoft.AspNetCore.Components.Routing
@using FSH.BlazorShared.Auth
@using FSH.BlazorShared.Permissions
@using MudBlazor
@inject IPermissionsProvider PermissionsProvider

<div class="space-y-6">
    <FshPageHeader Title="Settings" Icon="@Icons.Material.Filled.Settings" Tone="Color.Primary"
                   Description="Manage your personal settings." />

    <div class="d-flex flex-column flex-lg-row gap-6">
        <nav aria-label="Settings sections">
            <!-- Desktop: vertical sidebar (hidden below lg breakpoint) -->
            <div class="d-none d-lg-block" style="min-width: 240px;">
                <MudText Class="mb-3 pl-3" Style="font-size: 10px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.18em; opacity: 0.5;">Sections</MudText>
                <MudNavMenu>
                    <MudNavLink Href="/settings/profile" Icon="@Icons.Material.Filled.AccountCircle"
                                Match="NavLinkMatch.Prefix">Profile</MudNavLink>
                    <MudNavLink Href="/settings/security" Icon="@Icons.Material.Filled.Shield"
                                Match="NavLinkMatch.Prefix">Security</MudNavLink>
                    <MudNavLink Href="/settings/appearance" Icon="@Icons.Material.Filled.Palette"
                                Match="NavLinkMatch.Prefix">Appearance</MudNavLink>
                    @if (_canBranding)
                    {
                        <MudNavLink Href="/settings/branding" Icon="@Icons.Material.Filled.Brush"
                                    Match="NavLinkMatch.Prefix">Branding</MudNavLink>
                    }
                    <MudNavLink Href="/settings/notifications" Icon="@Icons.Material.Filled.Notifications"
                                Match="NavLinkMatch.Prefix">Notifications</MudNavLink>
                    <MudNavLink Href="/settings/api-keys" Icon="@Icons.Material.Filled.Key"
                                Match="NavLinkMatch.Prefix">API keys</MudNavLink>
                </MudNavMenu>
            </div>

            <!-- Mobile: horizontal scroll pill tabs (visible below lg) -->
            <div class="d-flex d-lg-none overflow-x-auto pb-1" style="gap: 4px;">
                <SettingsPillTab Href="/settings/profile" Icon="@Icons.Material.Filled.AccountCircle" Label="Profile" />
                <SettingsPillTab Href="/settings/security" Icon="@Icons.Material.Filled.Shield" Label="Security" />
                <SettingsPillTab Href="/settings/appearance" Icon="@Icons.Material.Filled.Palette" Label="Appearance" />
                @if (_canBranding)
                {
                    <SettingsPillTab Href="/settings/branding" Icon="@Icons.Material.Filled.Brush" Label="Branding" />
                }
                <SettingsPillTab Href="/settings/notifications" Icon="@Icons.Material.Filled.Notifications" Label="Notifications" />
                <SettingsPillTab Href="/settings/api-keys" Icon="@Icons.Material.Filled.Key" Label="API keys" />
            </div>
        </nav>

        <div class="flex-grow-1 min-w-0">
            @ChildContent
        </div>
    </div>
</div>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool _canBranding;

    protected override async Task OnInitializedAsync()
    {
        var permissions = await PermissionsProvider.GetPermissionsAsync();
        _canBranding = permissions.Contains(MultitenancyPermissions.Tenants.UpdateTheme);
    }
}
