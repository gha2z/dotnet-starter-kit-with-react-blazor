@page "/catalog/products/{Id}"
@attribute [Authorize]
@using FSH.BlazorShared.Formatting
@using MudBlazor

<MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2" OnClick="GoBack">
    Back to products
</MudButton>

@if (_error is not null)
{
    <FshErrorBand Message="@_error" />
}

@if (_loading)
{
    <div class="d-flex flex-column gap-3">
        <div class="fsh-skeleton" style="height: 96px; border-radius: 12px;"></div>
        <div class="fsh-skeleton" style="height: 256px; border-radius: 12px;"></div>
    </div>
}
else if (_product is null)
{
    @* React parity (NotFoundPanel): icon tile + copy + back action. *@
    <div class="fsh-notfound-panel">
        <span class="fsh-notfound-icon">
            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Medium" />
        </span>
        <h3 class="fsh-notfound-title">Product not found</h3>
        <p class="fsh-notfound-copy">It may have been deleted, or the link may be wrong.</p>
        <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="GoBack">Back to products</MudButton>
    </div>
}
else
{
    <div class="fsh-enter overflow-hidden rounded-xl border fsh-detail-card mb-5">
        <div class="fsh-detail-accent-bar" aria-hidden="true"></div>
        <div class="fsh-detail-hero-body">
            @* Identity row — React EntityDetailHero parity: avatar + title block LEFT,
               action buttons on the RIGHT (not stacked below). *@
            <div class="d-flex align-start justify-space-between gap-3 gap-sm-4">
                <div class="d-flex align-center gap-3 gap-sm-4 min-w-0">
                    <span class="fsh-detail-icon" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(_product.ThumbnailUrl))
                        {
                            <img src="@_product.ThumbnailUrl" alt="" style="width: 100%; height: 100%; object-fit: cover;" referrerpolicy="no-referrer" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Medium" />
                        }
                    </span>
                    <div class="min-w-0">
                        <div class="d-flex flex-wrap align-center gap-2">
                            <h1 class="fsh-detail-title">@_product.Name</h1>
                            @if (_product.IsActive)
                            {
                                <FshStatusPill Text="active" Tone="Color.Success" />
                            }
                            else
                            {
                                <FshStatusPill Text="hidden" Tone="Color.Default" />
                            }
                        </div>
                        <div class="fsh-detail-subtitle mt-1">
                            <code class="fsh-sku-chip">@_product.Sku</code>
                            @if (!string.IsNullOrEmpty(BrandNameOf))
                            {
                                <span aria-hidden="true" style="opacity:.5;">·</span>
                                <span>@BrandNameOf</span>
                            }
                            @if (!string.IsNullOrEmpty(CategoryNameOf))
                            {
                                <span aria-hidden="true" style="opacity:.5;">·</span>
                                <span>@CategoryNameOf</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-shrink-0 align-center gap-1">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Disabled="@_loading" OnClick="ReloadAsync">
                        <MudIcon Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" Class="@(_loading ? "fsh-spin" : "")" />
                        <span class="d-none d-sm-inline ml-1">Refresh</span>
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditorAsync">
                        <span class="d-none d-sm-inline">Edit</span>
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete"
                               Class="fsh-btn-danger-outline" OnClick="ConfirmDeleteAsync">
                        <span class="d-none d-sm-inline">Delete</span>
                    </MudButton>
                </div>
            </div>

            @* Stats row — price / stock / images (React EntityDetailStat pills) *@
            <div class="d-flex flex-wrap align-center gap-2 mt-4">
                <button class="fsh-detail-stat primary" title="Change price" @onclick="OpenPriceAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                    <span class="fsh-detail-stat-value">@FshFormat.Money(_product.Price.Amount, _product.Price.Currency)</span>
                    <span class="fsh-detail-stat-label">price</span>
                </button>
                <button class="fsh-detail-stat @StockTone" title="Adjust stock" @onclick="OpenStockAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                    <span class="fsh-detail-stat-value">@_product.Stock</span>
                    <span class="fsh-detail-stat-label">@StockLabel</span>
                </button>
                <span class="fsh-detail-stat">
                    <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Small" />
                    <span class="fsh-detail-stat-value">@(_product.Images?.Count ?? 0)</span>
                    <span class="fsh-detail-stat-label">images</span>
                </span>
            </div>

            @* Meta row — brand / category / created / revised (React EntityDetailMeta parity) *@
            <div class="fsh-detail-meta d-flex flex-wrap align-center mt-3" style="gap: 16px;">
                @if (_brand is not null)
                {
                    <span class="fsh-detail-meta-item"><MudIcon Icon="@Icons.Material.Outlined.Tag" Size="Size.Small" /> <a class="fsh-detail-meta-link" href="/catalog/products?brand=@_brand.Id">@BrandNameOf</a></span>
                }
                @if (_category is not null)
                {
                    <span class="fsh-detail-meta-item"><MudIcon Icon="@Icons.Material.Outlined.Layers" Size="Size.Small" /> <a class="fsh-detail-meta-link" href="/catalog/products?category=@_category.Id">@CategoryNameOf</a></span>
                }
                <span class="fsh-detail-meta-item d-none d-sm-inline-flex"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" /> Created @FshFormat.DateRelative(_product.CreatedAtUtc)</span>
                @if (_product.UpdatedAtUtc.HasValue)
                {
                    <span class="fsh-detail-meta-item d-none d-lg-inline-flex">Revised @FshFormat.DateRelative(_product.UpdatedAtUtc.Value)</span>
                }
            </div>
        </div>
    </div>

    <div class="fsh-prod-detail-grid mt-4">
        <div class="d-flex flex-column gap-4">
            @* Pricing *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center gap-2 mb-1" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                    Pricing
                </div>
                <div class="mt-2">
                    <span class="fsh-balance-amount">@FshFormat.Money(_product.Price.Amount, _product.Price.Currency)</span>
                    <div class="fsh-muted-copy" style="font-size: 11.5px; margin-top: 2px;">Listed price · @_product.Price.Currency</div>
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="mt-1" OnClick="OpenPriceAsync">
                    Change price
                </MudButton>
            </MudPaper>

            @* Inventory *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center gap-2 mb-1" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                    Inventory
                </div>
                <div class="mt-2">
                    <span class="fsh-balance-amount @InventoryTone" style="font-size: 26px;">@_product.Stock</span>
                </div>
                <div class="d-flex align-center gap-1 mt-1 @InventoryTone" style="font-size: 11.5px;">
                    @if (_product.Stock <= 0)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.RemoveCircleOutline" Size="Size.Small" />
                        <span>Out of stock</span>
                    }
                    else if (_product.Stock < 10)
                    {
                        <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" />
                        <span>Below 10 units</span>
                    }
                    else
                    {
                        <span style="color: var(--mud-palette-text-secondary);">Units on hand</span>
                    }
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="mt-1" OnClick="OpenStockAsync">
                    Adjust stock
                </MudButton>
            </MudPaper>

            @* Identifiers *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center gap-2 mb-1" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" />
                    Identifiers
                </div>
                <dl class="mt-2 mb-0">
                    <div class="fsh-prod-meta-row">
                        <dt>SKU</dt>
                        <dd class="fsh-truncate" title="@_product.Sku" style="font-family: var(--fsh-mono, monospace);">@_product.Sku</dd>
                    </div>
                    <div class="fsh-prod-meta-row">
                        <dt>Slug</dt>
                        <dd class="fsh-truncate" title="@_product.Slug" style="font-family: var(--fsh-mono, monospace);">@_product.Slug</dd>
                    </div>
                    <div class="fsh-prod-meta-row">
                        <dt>Product ID</dt>
                        <dd class="fsh-truncate" title="@_product.Id" style="font-family: var(--fsh-mono, monospace); font-size: 11px;">@_product.Id</dd>
                    </div>
                    <div class="fsh-prod-meta-row">
                        <dt>Brand ID</dt>
                        <dd class="fsh-truncate" title="@(_brand?.Id ?? _product.BrandId)" style="font-family: var(--fsh-mono, monospace); font-size: 11px;">@(_brand?.Id ?? _product.BrandId)</dd>
                    </div>
                    <div class="fsh-prod-meta-row">
                        <dt>Category ID</dt>
                        <dd class="fsh-truncate" title="@(_category?.Id ?? _product.CategoryId)" style="font-family: var(--fsh-mono, monospace); font-size: 11px;">@(_category?.Id ?? _product.CategoryId)</dd>
                    </div>
                </dl>
            </MudPaper>
        </div>

        <div class="d-flex flex-column gap-4">
            @* Description *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center justify-space-between gap-2 mb-1">
                    <div class="d-flex align-center gap-2" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                        <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                        Description
                    </div>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit"
                               OnClick="OpenEditorAsync">Edit</MudButton>
                </div>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-top: -6px;">Customer-facing copy shown on the product page.</MudText>
                @if (string.IsNullOrEmpty(_product.Description))
                {
                    <div class="fsh-muted-copy mt-3" style="font-size: 13px; font-style: italic;">No description on file. Customers will see a blank description on the product page until you add one.</div>
                }
                else
                {
                    <div class="mt-3" style="font-size: 13.5px; line-height: 1.6; color: var(--mud-palette-text-primary); white-space: pre-line;">@_product.Description</div>
                }
            </MudPaper>

            @* Images *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center justify-space-between gap-2 mb-1">
                    <div class="d-flex align-center gap-2" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                        <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" />
                        Images
                        <span class="fsh-count-chip" style="margin-left: 2px;">@(_product.Images?.Count ?? 0)</span>
                    </div>
                    <span class="fsh-muted-copy" style="font-size: 11.5px;">Drop more to add. Star one to make it the cover.</span>
                </div>

                <div class="d-flex align-center justify-space-between gap-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@(_uploading ? Icons.Material.Filled.HourglassTop : Icons.Material.Filled.UploadFile)"
                               Disabled="@_uploading"
                               OnClick="OpenImagePickerAsync">
                        @(_uploading ? "Uploading…" : "Upload images")
                    </MudButton>
                    @if (_uploading && !string.IsNullOrEmpty(_uploadStatus))
                    {
                        <span class="fsh-muted-copy" style="font-size: 12px;">@_uploadStatus</span>
                    }
                    else
                    {
                        <span class="fsh-muted-copy" style="font-size: 12px;">
                            @(_product.Images?.Count ?? 0) image@((_product.Images?.Count ?? 0) == 1 ? "" : "s")
                        </span>
                    }
                </div>
                @* Plain InputFile — MudFileUpload renders its own default "Browse Files"
                   button, which duplicated the UPLOAD IMAGES action above. *@
                <InputFile id="detail-image-input" OnChange="HandleImageFilesChanged"
                           multiple accept=".jpg,.jpeg,.png,.webp,.gif" style="display:none;" />

                @if ((_product.Images?.Count ?? 0) == 0)
                {
                    <div class="fsh-images-empty mt-4">No images yet. Upload one to set the product's cover.</div>
                }
                else
                {
                    <div class="fsh-prod-images mt-4">
                        @foreach (var image in (_product.Images ?? []).OrderBy(i => i.SortOrder))
                        {
                            var imageCapture = image;
                            <div class="fsh-prod-image-tile @(image.IsThumbnail ? "is-cover" : "")">
                                @if (image.IsThumbnail)
                                {
                                    <span class="fsh-prod-thumb-badge">
                                        <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small" />
                                        cover
                                    </span>
                                }
                                <button type="button" class="fsh-prod-image-hit" aria-label="Preview image"
                                        @onclick="() => PreviewImageAsync(imageCapture)">
                                    <img src="@image.Url" alt="Product image" loading="lazy" referrerpolicy="no-referrer" />
                                </button>
                                <div class="fsh-prod-image-actions">
                                    @if (!image.IsThumbnail)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.StarOutline" Size="Size.Small"
                                                       Class="fsh-prod-image-action" title="Set as cover" aria-label="Set as cover"
                                                       Disabled="@_uploading" OnClick="() => SetThumbnailAsync(imageCapture)" />
                                    }
                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small"
                                                   Class="fsh-prod-image-action fsh-prod-image-remove" title="Remove image" aria-label="Remove image"
                                                   Disabled="@_uploading" OnClick="() => ConfirmRemoveImageAsync(imageCapture)" />
                                </div>
                            </div>
                        }
                    </div>
                }
            </MudPaper>

            @* Audit — React parity: Created / Revised / Status three-up *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center gap-2 mb-1" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                    Audit
                </div>
                <div class="fsh-audit-grid mt-3">
                    <div>
                        <div class="fsh-mono-label" style="margin-bottom: 4px;">Created</div>
                        <div style="font-weight: 600; font-size: 13.5px;">@FshFormat.DateTimeShort(_product.CreatedAtUtc)</div>
                        <div class="fsh-muted-copy" style="font-size: 11.5px;">@FshFormat.DateRelative(_product.CreatedAtUtc)</div>
                    </div>
                    <div>
                        <div class="fsh-mono-label" style="margin-bottom: 4px;">Revised</div>
                        <div style="font-weight: 600; font-size: 13.5px;">@(_product.UpdatedAtUtc.HasValue ? FshFormat.DateTimeShort(_product.UpdatedAtUtc.Value) : "Never")</div>
                        <div class="fsh-muted-copy" style="font-size: 11.5px;">@(_product.UpdatedAtUtc.HasValue ? FshFormat.DateRelative(_product.UpdatedAtUtc.Value) : "no edits since creation")</div>
                    </div>
                    <div>
                        <div class="fsh-mono-label" style="margin-bottom: 4px;">Status</div>
                        <div style="font-weight: 600; font-size: 13.5px; color: @(_product.IsActive ? "var(--mud-palette-success)" : "var(--mud-palette-text-secondary)")">@( _product.IsActive ? "Active" : "Hidden")</div>
                    </div>
                </div>
            </MudPaper>
        </div>
    </div>
}
