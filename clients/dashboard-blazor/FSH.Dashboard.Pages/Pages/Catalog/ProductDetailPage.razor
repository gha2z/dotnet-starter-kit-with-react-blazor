@page "/catalog/products/{Id}"
@attribute [Authorize]
@using FSH.BlazorShared.Formatting
@using MudBlazor

<MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowBack" Class="mb-2" OnClick="GoBack">
    Back to products
</MudButton>

@if (_error is not null)
{
    <FshErrorBand Message="@_error" />
}

@if (_loading)
{
    <div class="d-flex flex-column gap-3">
        <div class="fsh-skeleton" style="height: 96px; border-radius: 12px;"></div>
        <div class="fsh-skeleton" style="height: 256px; border-radius: 12px;"></div>
    </div>
}
else if (_product is null)
{
    <FshEmptyState Icon="@Icons.Material.Filled.SearchOff"
                   Title="Product not found"
                   Description="This product doesn't exist, or you don't have access to it." />
}
else
{
    <div class="fsh-enter overflow-hidden rounded-xl border fsh-detail-card mb-5">
        <div class="fsh-detail-accent-bar" aria-hidden="true"></div>
        <div class="fsh-detail-hero-body">
            @* Identity row — React EntityDetailHero parity: avatar + title block LEFT,
               action buttons on the RIGHT (not stacked below). *@
            <div class="d-flex align-start justify-space-between gap-3 gap-sm-4">
                <div class="d-flex align-center gap-3 gap-sm-4 min-w-0">
                    <span class="fsh-detail-icon" aria-hidden="true">
                        @if (!string.IsNullOrEmpty(_product.ThumbnailUrl))
                        {
                            <img src="@_product.ThumbnailUrl" alt="" style="width: 100%; height: 100%; object-fit: cover;" referrerpolicy="no-referrer" />
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Medium" />
                        }
                    </span>
                    <div class="min-w-0">
                        <div class="d-flex flex-wrap align-center gap-2">
                            <h1 class="fsh-detail-title">@_product.Name</h1>
                            @if (_product.IsActive)
                            {
                                <FshStatusPill Text="active" Tone="Color.Success" />
                            }
                            else
                            {
                                <FshStatusPill Text="hidden" Tone="Color.Default" />
                            }
                        </div>
                        <div class="fsh-detail-subtitle mt-1">
                            <code class="fsh-sku-chip">@_product.Sku</code>
                            @if (!string.IsNullOrEmpty(BrandNameOf))
                            {
                                <span class="fsh-detail-meta-item"><MudIcon Icon="@Icons.Material.Outlined.Tag" Size="Size.Small" /> @BrandNameOf</span>
                            }
                            @if (!string.IsNullOrEmpty(CategoryNameOf))
                            {
                                <span class="fsh-detail-meta-item"><MudIcon Icon="@Icons.Material.Outlined.Layers" Size="Size.Small" /> @CategoryNameOf</span>
                            }
                        </div>
                    </div>
                </div>
                <div class="d-flex flex-shrink-0 align-center gap-1">
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                               Disabled="@_loading" OnClick="ReloadAsync">
                        <span class="d-none d-sm-inline">Refresh</span>
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Edit" OnClick="OpenEditorAsync">
                        <span class="d-none d-sm-inline">Edit</span>
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Delete"
                               Class="fsh-btn-danger-outline" OnClick="ConfirmDeleteAsync">
                        <span class="d-none d-sm-inline">Delete</span>
                    </MudButton>
                </div>
            </div>

            @* Stats row — price / stock / images (React EntityDetailStat pills) *@
            <div class="d-flex flex-wrap align-center gap-2 mt-4">
                <button class="fsh-detail-stat primary" title="Change price" @onclick="OpenPriceAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                    <span class="fsh-detail-stat-value">@FshFormat.Money(_product.Price.Amount, _product.Price.Currency)</span>
                    <span class="fsh-detail-stat-label">price</span>
                </button>
                <button class="fsh-detail-stat @StockTone" title="Adjust stock" @onclick="OpenStockAsync">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                    <span class="fsh-detail-stat-value">@_product.Stock</span>
                    <span class="fsh-detail-stat-label">@StockLabel</span>
                </button>
                <span class="fsh-detail-stat">
                    <MudIcon Icon="@Icons.Material.Filled.Layers" Size="Size.Small" />
                    <span class="fsh-detail-stat-value">@(_product.Images?.Count ?? 0)</span>
                    <span class="fsh-detail-stat-label">images</span>
                </span>
            </div>

            @* Meta row — created / updated *@
            <div class="d-flex flex-wrap align-center gap-x-4 gap-y-1 fsh-detail-meta mt-3">
                <span class="fsh-detail-meta-item"><MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" /> Created @FshFormat.DateRelative(_product.CreatedAtUtc)</span>
                @if (_product.UpdatedAtUtc.HasValue)
                {
                    <span class="fsh-detail-meta-item">Updated @FshFormat.DateRelative(_product.UpdatedAtUtc.Value)</span>
                }
            </div>
        </div>
    </div>

    <div class="fsh-prod-detail-grid mt-4">
        <div class="d-flex flex-column gap-4">
            @* Pricing *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center gap-2 mb-1" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.Payments" Size="Size.Small" />
                    Pricing
                </div>
                <div class="mt-2">
                    <span class="fsh-balance-amount">@FshFormat.Money(_product.Price.Amount, _product.Price.Currency)</span>
                </div>
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="mt-1" OnClick="OpenPriceAsync">
                    Change price
                </MudButton>
            </MudPaper>

            @* Inventory *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center gap-2 mb-1" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.Inventory2" Size="Size.Small" />
                    Inventory
                </div>
                <div class="mt-2 d-flex align-center gap-2">
                    <span class="fsh-balance-amount" style="font-size: 26px;">@_product.Stock</span>
                    <span class="fsh-muted-copy" style="font-size: 12px;">in stock</span>
                </div>
                @StockChipInline(_product)
                <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" Class="mt-1" OnClick="OpenStockAsync">
                    Adjust stock
                </MudButton>
            </MudPaper>

            @* Identifiers *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center gap-2 mb-1" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.Tag" Size="Size.Small" />
                    Identifiers
                </div>
                <dl class="mt-2 mb-0">
                    <div class="fsh-prod-meta-row">
                        <dt>SKU</dt>
                        <dd class="fsh-truncate" style="font-family: var(--fsh-mono, monospace);">@_product.Sku</dd>
                    </div>
                    <div class="fsh-prod-meta-row">
                        <dt>Slug</dt>
                        <dd class="fsh-truncate" style="font-family: var(--fsh-mono, monospace);">@_product.Slug</dd>
                    </div>
                    <div class="fsh-prod-meta-row">
                        <dt>Brand</dt>
                        <dd class="fsh-truncate">@(_brand?.Name ?? "—")</dd>
                    </div>
                    <div class="fsh-prod-meta-row">
                        <dt>Category</dt>
                        <dd class="fsh-truncate">@(_category?.Name ?? "—")</dd>
                    </div>
                </dl>
            </MudPaper>
        </div>

        <div class="d-flex flex-column gap-4">
            @* Description *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center gap-2 mb-1" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.Description" Size="Size.Small" />
                    Description
                </div>
                @if (string.IsNullOrEmpty(_product.Description))
                {
                    <div class="fsh-muted-copy" style="font-size: 13px;">No description for this product yet.</div>
                }
                else
                {
                    <div class="mt-2" style="font-size: 13.5px; line-height: 1.6; color: var(--mud-palette-text-primary); white-space: pre-line;">@_product.Description</div>
                }
            </MudPaper>

            @* Images *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center gap-2 mb-3" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.Image" Size="Size.Small" />
                    Images
                    <span class="fsh-count-chip" style="margin-left: 2px;">@(_product.Images?.Count ?? 0)</span>
                </div>

                <div class="d-flex align-center gap-2 mb-3">
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.UploadFile"
                               Disabled="@_uploading"
                               OnClick="OpenImagePickerAsync">
                        @(_uploading ? "Uploading…" : "Upload images")
                    </MudButton>
                    <span class="fsh-muted-copy" style="font-size: 12px;">
                        @_product.Images.Count image@(_product.Images.Count == 1 ? "" : "s") · JPG / PNG / WebP / GIF · up to 10 MB
                    </span>
                </div>
                <MudFileUpload @ref="_fileUpload" T="IReadOnlyList<IBrowserFile>" @bind-Files="_pickedFiles"
                               Hidden="true" Accept=".jpg,.jpeg,.png,.webp,.gif"
                               OnFilesChanged="UploadImagesAsync" />

                @if (_product.Images.Count == 0)
                {
                    <div class="fsh-muted-copy" style="font-size: 13px;">No images yet — upload one to set the product's cover.</div>
                }
                else
                {
                    <div class="fsh-prod-images">
                        @foreach (var image in _product.Images.OrderBy(i => i.SortOrder))
                        {
                            <div class="fsh-prod-image-tile">
                                @if (image.IsThumbnail)
                                {
                                    <span class="fsh-prod-thumb-badge">cover</span>
                                }
                                <img src="@image.Url" alt="" loading="lazy" referrerpolicy="no-referrer" />
                                <div class="fsh-prod-image-actions">
                                    @if (!image.IsThumbnail)
                                    {
                                        <MudTooltip Text="Set as cover">
                                            <MudIconButton Icon="@Icons.Material.Filled.Star" Size="Size.Small" Color="Color.Warning"
                                                           aria-label="Set as cover"
                                                           OnClick="() => SetThumbnailAsync(image)" />
                                        </MudTooltip>
                                    }
                                    <MudTooltip Text="Remove image">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                       aria-label="Remove image"
                                                       OnClick="() => DeleteImageAsync(image)" />
                                    </MudTooltip>
                                </div>
                            </div>
                        }
                    </div>
                }
            </MudPaper>

            @* Audit *@
            <MudPaper Elevation="0" Class="fsh-section-card">
                <div class="d-flex align-center gap-2 mb-1" style="font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; color: var(--mud-palette-text-secondary);">
                    <MudIcon Icon="@Icons.Material.Filled.History" Size="Size.Small" />
                    Audit
                </div>
                <dl class="mt-2 mb-0">
                    <div class="fsh-prod-meta-row">
                        <dt>Created</dt>
                        <dd>@FshFormat.DateTimeShort(_product.CreatedAtUtc)</dd>
                    </div>
                    <div class="fsh-prod-meta-row">
                        <dt>Updated</dt>
                        <dd>@FshFormat.DateTimeShort(_product.UpdatedAtUtc)</dd>
                    </div>
                </dl>
            </MudPaper>
        </div>
    </div>
}
