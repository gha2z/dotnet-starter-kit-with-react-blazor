@namespace FSH.Dashboard.Wasm.Pages.Catalog
@using FSH.BlazorShared.Models.Catalog
@using FSH.BlazorShared.Services
@using MudBlazor

<MudDialog>
    <DialogContent>
        <FshFormDialogHeader Icon="@Icons.Material.Filled.Inventory2"
                             Title="@(Product is null ? "Add a product" : "Edit product")"
                             Description="@(Product is null
                ? "Add a product to your catalog. Give it a brand, a category, an initial price, and a starting stock."
                : $"Update {Product.Name}. Price and stock are changed separately so the ledger stays traceable.")" />

        @* React parity (ProductEditorDialog): Name | SKU on one row *@
        <div class="fsh-dialog-grid-2 mb-1">
            <MudTextField T="string"
                          @bind-Value="_name"
                          Label="Name"
                          Placeholder="Classic Cotton Tee"
                          Required="true"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="200" />
            <MudTextField T="string"
                          @bind-Value="_sku"
                          Label="SKU"
                          Placeholder="ACM-TS-001"
                          Required="@(Product is null)"
                          Disabled="@(Product is not null)"
                          HelperText="@(Product is null ? "Stock-keeping unit. Becomes the canonical identifier." : "SKU is fixed after creation.")"
                          Variant="Variant.Outlined"
                          Margin="Margin.Dense"
                          MaxLength="64"
                          UserAttributes="@(_skuInputAttrs)" />
        </div>

        @* Brand | Category — searchable pickers (React Combobox parity) *@
        <div class="fsh-dialog-grid-2 mb-1">
            <MudAutocomplete T="BrandDto"
                             Value="_brandSel"
                             ValueChanged="OnBrandSelChanged"
                             SearchFunc="FilterBrands"
                             ToStringFunc="@(b => b?.Name ?? string.Empty)"
                             Label="Brand"
                             Placeholder="Select a brand…"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             MaxItems="8" />
            <MudAutocomplete T="CategoryDto"
                             Value="_catSel"
                             ValueChanged="OnCatSelChanged"
                             SearchFunc="FilterCategories"
                             ToStringFunc="@(c => c?.Name ?? string.Empty)"
                             Label="Category"
                             Placeholder="Select a category…"
                             Variant="Variant.Outlined"
                             Margin="Margin.Dense"
                             Clearable="true"
                             ResetValueOnEmptyText="true"
                             MaxItems="8" />
        </div>

        @if (Product is null)
        {
            @* Price | Currency | Stock — one row (create only) *@
            <div class="fsh-dialog-grid-3 mb-1">
                <MudTextField T="decimal" @bind-Value="_priceAmount"
                              Label="Price"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
                <MudTextField T="string" @bind-Value="_currency"
                              Label="Currency"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              MaxLength="3" />
                <MudTextField T="int" @bind-Value="_stock"
                              Label="Stock"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense" />
            </div>
        }

        <MudTextField T="string"
                      @bind-Value="_description"
                      Label="Description"
                      HelperText="Shown on the product detail page."
                      Placeholder="100% organic cotton crew-neck."
                      Variant="Variant.Outlined"
                      Margin="Margin.Dense"
                      Lines="3"
                      Class="mb-1"
                      MaxLength="4000" />

        @if (Product is not null)
        {
            <div class="d-flex align-center justify-space-between mt-2" style="border: 1px solid var(--mud-palette-divider); border-radius: 10px; padding: 12px 14px;">
                <div>
                    <div style="font-size: 11.5px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: var(--mud-palette-text-secondary);">Visibility</div>
                    <div class="fsh-muted-copy" style="font-size: 12.5px;">@(_isActive ? "Listed for customers." : "Hidden from listings.")</div>
                </div>
                <MudSwitch T="bool" @bind-Value="_isActive" Color="Color.Primary" aria-label="Active" />
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="mt-4">
                <FshErrorBand Message="@_error" />
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Disabled="_isSubmitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync"
                   Disabled="_isSubmitting || string.IsNullOrWhiteSpace(_name) || (Product is null && string.IsNullOrWhiteSpace(_sku)) || _brandId is null || _categoryId is null">
            @(_isSubmitting ? "Saving…" : Product is null ? "Add product" : "Save changes")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    private static readonly Dictionary<string, object> _skuInputAttrs = new() { ["style"] = "text-transform: uppercase; font-family: var(--fsh-mono, monospace); font-size: 13px;" };

    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Inject] private ICatalogService Catalog { get; set; } = default!;

    [Parameter] public ProductDto? Product { get; set; }
    [Parameter] public IReadOnlyList<BrandDto> Brands { get; set; } = [];
    [Parameter] public IReadOnlyList<CategoryDto> Categories { get; set; } = [];

    private string _sku = string.Empty;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private Guid? _brandId;
    private Guid? _categoryId;
    private decimal _priceAmount;
    private string _currency = "USD";
    private int _stock;
    private bool _isActive = true;
    private string? _error;
    private bool _isSubmitting;

    // Searchable picker selections (React Combobox parity); the Guid ids derive from these.
    private BrandDto? _brandSel;
    private CategoryDto? _catSel;

    private Task<IEnumerable<BrandDto>> FilterBrands(string term, CancellationToken ct) =>
        Task.FromResult(Brands.Where(b => b.Name.Contains(term, StringComparison.OrdinalIgnoreCase)).AsEnumerable());

    private Task<IEnumerable<CategoryDto>> FilterCategories(string term, CancellationToken ct) =>
        Task.FromResult(Categories.Where(c => c.Name.Contains(term, StringComparison.OrdinalIgnoreCase)).AsEnumerable());

    private void OnBrandSelChanged(BrandDto? value)
    {
        _brandSel = value;
        _brandId = value?.Id;
    }

    private void OnCatSelChanged(CategoryDto? value)
    {
        _catSel = value;
        _categoryId = value?.Id;
    }

    protected override void OnInitialized()
    {
        if (Product is not null)
        {
            _name = Product.Name;
            _description = Product.Description ?? string.Empty;
            _brandId = Product.BrandId;
            _categoryId = Product.CategoryId;
            _brandSel = Brands.FirstOrDefault(b => b.Id == Product.BrandId);
            _catSel = Categories.FirstOrDefault(c => c.Id == Product.CategoryId);
            _priceAmount = Product.Price.Amount;
            _currency = Product.Price.Currency;
            _stock = Product.Stock;
            _isActive = Product.IsActive;
        }
    }

    private async Task SubmitAsync()
    {
        var name = _name.Trim();
        if (string.IsNullOrEmpty(name) || _brandId is null || _categoryId is null)
        {
            return;
        }

        _isSubmitting = true;
        _error = null;
        try
        {
            var description = string.IsNullOrWhiteSpace(_description) ? null : _description.Trim();
            if (Product is not null)
            {
                await Catalog.UpdateProductAsync(new UpdateProductRequest(Product.Id, name, description, _brandId.Value, _categoryId.Value, _isActive));
            }
            else
            {
                var sku = _sku.Trim();
                if (string.IsNullOrEmpty(sku))
                {
                    return;
                }

                await Catalog.CreateProductAsync(new CreateProductRequest(
                    sku, name, description, _brandId.Value, _categoryId.Value, _priceAmount, _currency, _stock));
            }

            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
