@namespace FSH.Dashboard.Wasm.Pages.Catalog
@using FSH.BlazorShared.Models.Catalog
@using FSH.BlazorShared.Services
@using MudBlazor

@* React parity (product-detail.tsx StockDialog): current→becomes preview with delta
   coloring, minus/plus stepper, negative-stock guard banner, domain-event copy. *@
<MudDialog>
    <DialogContent>
        <div class="d-flex align-center gap-2 mb-2">
            <FshToneIconTile Icon="@Icons.Material.Filled.Inventory2" Tone="Color.Success" TileSize="32px" IconSize="Size.Small" />
            <MudText Typo="Typo.h6" Style="margin: 0;">Adjust stock</MudText>
        </div>
        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-4" Style="display: block;">
            <span style="font-weight: 500; color: var(--mud-palette-text-primary);">@Product.Name</span>
            — add or remove units. Emits a <code class="fsh-sku-chip">ProductStockAdjusted</code> event.
        </MudText>

        <div class="fsh-was-becomes mb-4">
            <div>
                <div class="fsh-mono-label">current</div>
                <div class="fsh-was-becomes-value">@Product.Stock</div>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Color="Color.Secondary" Class="fsh-was-becomes-arrow" />
            <div style="text-align: right;">
                <div class="fsh-mono-label" style="color: var(--mud-palette-primary);">becomes</div>
                <div class="fsh-was-becomes-value @BecomesTone">@NewStock</div>
            </div>
        </div>

        <div class="d-flex align-center gap-2">
            <MudIconButton Icon="@Icons.Material.Filled.Remove" Variant="Variant.Outlined" Size="Size.Small"
                           aria-label="Decrease by 1" Disabled="_isSubmitting" OnClick="@( () => Adjust(-1) )" />
            <MudTextField T="string" Value="_delta" ValueChanged="SetDelta" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Immediate="true" Class="fsh-delta-input" />
            <MudIconButton Icon="@Icons.Material.Filled.Add" Variant="Variant.Outlined" Size="Size.Small"
                           aria-label="Increase by 1" Disabled="_isSubmitting" OnClick="@( () => Adjust(1) )" />
        </div>

        @if (WillGoNegative)
        {
            <div class="fsh-negative-guard mt-3">
                <MudIcon Icon="@Icons.Material.Filled.WarningAmber" Size="Size.Small" Class="flex-shrink-0 mt-1" />
                <span>
                    Stock cannot go negative. The maximum decrement here is
                    <span style="font-family: var(--fsh-mono, monospace); font-weight: 600;">@Product.Stock</span>.
                </span>
            </div>
        }

        @if (!string.IsNullOrEmpty(_error))
        {
            <div class="mt-4">
                <FshErrorBand Message="@_error" />
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" OnClick="Cancel" Disabled="_isSubmitting">Cancel</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SubmitAsync"
                   Disabled="@(_isSubmitting || !IsValid || WillGoNegative)">
            @(_isSubmitting ? "Adjusting…" : "Adjust stock")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance Dialog { get; set; } = default!;
    [Inject] private ICatalogService Catalog { get; set; } = default!;

    [Parameter] public ProductDto Product { get; set; } = default!;

    private string _delta = "0";
    private string? _error;
    private bool _isSubmitting;

    private int? ParsedDelta => int.TryParse(_delta, out var v) ? v : null;

    private bool IsValid => ParsedDelta is not null && ParsedDelta.Value != 0;

    private int NewStock => Product.Stock + (ParsedDelta ?? 0);

    private bool WillGoNegative => NewStock < 0;

    private string BecomesTone => ParsedDelta is null ? ""
        : WillGoNegative ? "is-down" : ParsedDelta.Value > 0 ? "is-up" : ParsedDelta.Value < 0 ? "is-warn" : "";

    private void SetDelta(string value) => _delta = value.TrimStart('+');

    private void Adjust(int step) => _delta = ((ParsedDelta ?? 0) + step).ToString();

    private async Task SubmitAsync()
    {
        if (!IsValid || WillGoNegative)
        {
            return;
        }

        _isSubmitting = true;
        _error = null;
        try
        {
            await Catalog.AdjustProductStockAsync(Product.Id, new AdjustProductStockRequest(ParsedDelta!.Value));
            Dialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }

    private void Cancel() => Dialog.Cancel();
}
