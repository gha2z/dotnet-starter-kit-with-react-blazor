@page "/catalog/categories"
@attribute [Authorize]
@using FSH.BlazorShared.Formatting
@using MudBlazor

<FshPageHeader Title="Categories"
               Description="Group products into shelves. Categories nest under parents to form the taxonomy customers browse."
               Icon="@Icons.Material.Filled.FolderShared"
               Count="@(_totalCount == 0 && _loading ? null : _totalCount)"
               Unit="category">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
               OnClick="() => OpenEditorAsync(null)">
        New category
    </MudButton>
</FshPageHeader>

<MudTextField @bind-Value="_search"
              Placeholder="Search by name or slug…"
              Variant="Variant.Outlined"
              Adornment="Adornment.Start"
              AdornmentIcon="@Icons.Material.Filled.Search"
              Class="mb-4"
              Immediate="true" />

@if (_error is not null)
{
    <FshErrorBand Message="@_error" />
}

@if (_loading)
{
    @for (var i = 0; i < 4; i++)
    {
        <div class="fsh-skeleton" style="height: 56px; border-radius: 12px; margin-bottom: 8px;"></div>
    }
}
else if (Filtered.Count == 0)
{
    <FshEmptyState Icon="@(SearchActive ? Icons.Material.Filled.Search : Icons.Material.Filled.FolderShared)"
                   Title="@(SearchActive ? "No categories found" : "No categories yet")"
                   Description="@EmptyStateDescription">
        @if (SearchActive)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ClearSearch">Clear search</MudButton>
        }
        else
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Add" OnClick="() => OpenEditorAsync(null)">
                Add category
            </MudButton>
        }
    </FshEmptyState>
}
else
{
    <div class="d-flex justify-space-between align-center mb-3">
        <p class="fsh-muted-copy" style="font-size: 12px; font-weight: 500; margin: 0;">@MetaText</p>
    </div>

    <div class="fsh-categories-grid fsh-list-head">
        <span>Category</span>
        <span>Slug</span>
        <span>Created</span>
        <span></span>
    </div>

    @for (var i = 0; i < Filtered.Count; i++)
    {
        var category = Filtered[i];
        var isLast = i == Filtered.Count - 1;
        <div class="fsh-categories-grid fsh-list-row @(isLast ? "" : "fsh-row-border")">
            <div class="d-flex align-center gap-3 min-w-0">
                <span class="fsh-prod-thumb">
                    <span class="fsh-prod-initial">@Initial(category.Name)</span>
                </span>
                <div class="min-w-0">
                    <div class="fsh-truncate" style="font-size: 14px; font-weight: 500; color: var(--mud-palette-text-primary);">@category.Name</div>
                    <div class="d-flex align-center gap-1 fsh-truncate fsh-muted-copy" style="font-size: 12px;">
                        @if (category.ParentCategoryId.HasValue)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" Style="font-size: 14px; opacity: 0.6;" />
                            <span class="fsh-truncate">under @(ParentName(category.ParentCategoryId.Value))</span>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Style="font-size: 14px; opacity: 0.6;" />
                            <span>root</span>
                        }
                        @if (!string.IsNullOrEmpty(category.Description))
                        {
                            <span style="opacity: 0.4;">·</span>
                            <span class="fsh-truncate" title="@category.Description">@category.Description</span>
                        }
                    </div>
                </div>
            </div>
            <code class="fsh-truncate fsh-mono-muted" style="font-size: 12px;" title="@category.Slug">@category.Slug</code>
            <div class="min-w-0" style="font-size: 12px; color: var(--mud-palette-text-secondary); font-variant-numeric: tabular-nums;">
                <div class="fsh-truncate">@FshFormat.DateShort(category.CreatedAtUtc)</div>
            </div>
            <div class="d-flex align-center justify-end gap-1">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                               Color="Color.Default" aria-label="@($"Edit {category.Name}")"
                               OnClick="() => OpenEditorAsync(category)" />
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                               Color="Color.Error" aria-label="@($"Delete {category.Name}")"
                               OnClick="() => ConfirmDeleteAsync(category)" />
            </div>
        </div>
    }

    @if (!SearchActive && _totalPages > 1)
    {
        <div class="d-flex align-center justify-center gap-2 mt-4">
            <FshPager TotalCount="@_totalCount" PageNumber="@_pageNumber" PageSize="@PageSize" PageChanged="GoToPage" />
        </div>
    }
}
