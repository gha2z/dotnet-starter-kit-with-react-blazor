@page "/chat"
@page "/chat/{Id:guid}"
@using FSH.BlazorShared.Permissions
@attribute [Authorize]

<FshPageHeader Icon="@Icons.Material.Outlined.Chat" Title="Chat" Description="Team conversations and direct messages" />

<MudGrid Class="fsh-chat-root" Style="height: calc(100vh - 160px);">
    @* ── Left: Channel Rail ────────────────────────────────────── *@
    <MudItem xs="12" md="3" Class="fsh-chat-rail" Style="height: 100%; min-height: 0;">
        <MudPaper Class="d-flex flex-column" Style="height: 100%; border-radius: var(--mud-default-border-radius);" Elevation="0">
            <div class="d-flex align-center pa-3">
                <MudTextField @bind-Value="_searchChannels" Placeholder="Search channels..." Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Outlined.Search" IconSize="Size.Small" Immediate="true"
                              Margin="Margin.Dense" Variant="Variant.Outlined" Class="flex-grow-1" />
            </div>

            <hr class="fsh-chat-divider" />

            <div class="fsh-chat-channel-list" style="flex: 1; overflow-y: auto;">
                @* ── Channels section ─────────────────────────────────── *@
                <div class="fsh-chat-section">
                    <div class="d-flex align-center justify-space-between px-3 pt-2 pb-1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600; text-transform: uppercase;">
                            Channels
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Outlined.Add" Size="Size.Small" OnClick="OpenCreateChannelDialog"
                                       Class="fsh-chat-section-add" aria-label="Create channel" />
                    </div>
                    @if (_loadingChannels)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="d-flex mx-auto my-4" />
                    }
                    else if (ChannelsSection.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="pa-3" Color="Color.Secondary">
                            @(string.IsNullOrWhiteSpace(_searchChannels) ? "No channels yet." : "No matches.")
                        </MudText>
                    }
                    else
                    {
                        @foreach (var ch in ChannelsSection)
                        {
                            var isActive = ch.Id == _activeChannelId;
                            <MudListItem @key="ch.Id" T="ChannelDto" Value="ch" OnClick="() => SelectChannel(ch.Id)"
                                         Class="@ChannelItemClass(isActive)">
                                <div class="d-flex align-center" style="width: 100%;">
                                    <MudIcon Icon="@ChannelIcon(ch.Type)" Size="Size.Small" Class="mr-2"
                                             Color="@ChannelIconColor(isActive)" />
                                    <div class="flex-grow-1" style="min-width: 0;">
                                        <MudText Typo="Typo.body2" Style="@ChannelTextWeight(isActive)">
                                            @(ch.Name ?? "(unnamed channel)")
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @(ch.LastMessageAtUtc.HasValue ? FshFormat.DateRelative(ch.LastMessageAtUtc.Value) : "No messages")
                                        </MudText>
                                    </div>
                                    @if (ch.UnreadCount > 0)
                                    {
                                        <MudBadge Content="ch.UnreadCount.ToString()" Color="Color.Primary" Overlap="true" Class="ml-1" />
                                    }
                                </div>
                            </MudListItem>
                        }
                    }
                </div>

                @* ── Direct Messages section ──────────────────────────── *@
                <div class="fsh-chat-section mt-1">
                    <div class="d-flex align-center justify-space-between px-3 pt-2 pb-1">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600; text-transform: uppercase;">
                            Direct Messages
                        </MudText>
                        <MudIconButton Icon="@Icons.Material.Outlined.Add" Size="Size.Small" OnClick="OpenNewDmDialog"
                                       Class="fsh-chat-section-add" aria-label="New direct message" />
                    </div>
                    @if (_loadingChannels)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="d-flex mx-auto my-4" />
                    }
                    else if (DmsSection.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="pa-3" Color="Color.Secondary">
                            @(string.IsNullOrWhiteSpace(_searchChannels) ? "No conversations." : "No matches.")
                        </MudText>
                    }
                    else
                    {
                        @foreach (var ch in DmsSection)
                        {
                            var isActive = ch.Id == _activeChannelId;
                            <MudListItem @key="ch.Id" T="ChannelDto" Value="ch" OnClick="() => SelectChannel(ch.Id)"
                                         Class="@ChannelItemClass(isActive)">
                                <div class="d-flex align-center" style="width: 100%;">
                                    <MudIcon Icon="@ChannelIcon(ch.Type)" Size="Size.Small" Class="mr-2"
                                             Color="@ChannelIconColor(isActive)" />
                                    <div class="flex-grow-1" style="min-width: 0;">
                                        <MudText Typo="Typo.body2" Style="@ChannelTextWeight(isActive)">
                                            @ChannelTitleFor(ch)
                                        </MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                                            @(ch.LastMessageAtUtc.HasValue ? FshFormat.DateRelative(ch.LastMessageAtUtc.Value) : "No messages")
                                        </MudText>
                                    </div>
                                    @if (ch.UnreadCount > 0)
                                    {
                                        <MudBadge Content="ch.UnreadCount.ToString()" Color="Color.Primary" Overlap="true" Class="ml-1" />
                                    }
                                </div>
                            </MudListItem>
                        }
                    }
                </div>
            </div>
        </MudPaper>
    </MudItem>

    @* ── Right: Active Channel ─────────────────────────────────── *@
    <MudItem xs="12" md="9" Class="d-flex flex-column" Style="height: 100%; min-height: 0;">
        @if (_activeChannelId is null)
        {
            <MudPaper Class="d-flex align-center justify-center flex-grow-1" Elevation="0" Style="border-radius: var(--mud-default-border-radius);">
                <div class="text-center">
                    <MudIcon Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Large" Color="Color.Secondary" Style="font-size: 64px;" />
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-4">Select a channel to start chatting</MudText>
                </div>
            </MudPaper>
        }
        else
        {
            @* Header *@
            <MudPaper Class="d-flex align-center pa-3 mb-1" Elevation="0" Style="border-radius: var(--mud-default-border-radius);">
                <MudIcon Icon="@ChannelIcon(_activeChannel?.Type ?? ChannelType.Channel)" Class="mr-2" />
                <div class="flex-grow-1">
                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@(_activeChannel is null ? "Direct Message" : ChannelTitleFor(_activeChannel))</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(_activeChannel?.Members.Count ?? 0) member@((_activeChannel?.Members.Count ?? 0) != 1 ? "s" : "")
                    </MudText>
                </div>
                @if (_activeChannel?.UnreadCount > 0)
                {
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                        @_activeChannel.UnreadCount unread
                    </MudChip>
                }
            </MudPaper>

            @* Messages *@
            <div class="fsh-chat-messages flex-grow-1" style="overflow-y: auto;" @ref="_messagesContainer">
                @if (_loadingMessages)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="d-flex mx-auto my-4" />
                }
                else if (_messages.Count == 0)
                {
                    <MudText Typo="Typo.body2" Class="pa-4 text-center" Color="Color.Secondary">
                        No messages yet. Send the first message!
                    </MudText>
                }
                else
                {
                    @foreach (var item in _renderItems)
                    {
                        if (item is DaySeparatorItem day)
                        {
                            <div class="d-flex justify-center my-2">
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="fsh-chat-day-separator">
                                    @day.Label
                                </MudChip>
                            </div>
                        }
                        else if (item is MessageBlockItem block)
                        {
                            var first = block.Messages[0];
                            <div @key="first.Id" class="fsh-chat-message @(block.IsOwn ? "fsh-chat-message-own" : "fsh-chat-message-other")">
                                @if (!block.IsOwn)
                                {
                                    <MudAvatar Size="Size.Small" Color="Color.Primary" Class="mr-2">@InitialsFor(block.Author, block.AuthorId)</MudAvatar>
                                }
                                <div class="fsh-chat-message-bubble">
                                    @if (!block.IsOwn)
                                    {
                                        <div class="d-flex align-baseline flex-wrap">
                                            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600; margin-right: 6px;">@block.DisplayName</MudText>
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="margin-right: 6px;">@block.Handle</MudText>
                                        </div>
                                    }
                                    @foreach (var msg in block.Messages)
                                    {
                                        <div class="fsh-chat-message-row">
                                            @if (msg.DeletedAtUtc.HasValue)
                                            {
                                                <MudText Typo="Typo.body2" Style="font-style: italic;" Color="Color.Secondary">Message deleted</MudText>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.body2">@msg.Body</MudText>
                                            }
                                            @if (msg.Attachments.Count > 0)
                                            {
                                                <div class="mt-1">
                                                    @foreach (var att in msg.Attachments)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Icon="@Icons.Material.Outlined.Attachment"
                                                                 Href="@att.Url" Target="_blank">@att.OriginalFileName</MudChip>
                                                    }
                                                </div>
                                            }
                                            @if (msg.Reactions.Count > 0)
                                            {
                                                <div class="d-flex flex-wrap gap-1 mt-1">
                                                    @foreach (var reaction in msg.Reactions.GroupBy(r => r.Emoji))
                                                    {
                                                        var isMine = reaction.Any(r => r.UserId == _currentUserId);
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined"
                                                                 Class="@ReactionClass(isMine)"
                                                                 OnClick="() => ToggleReaction(msg.Id, reaction.Key)">
                                                            @reaction.Key @reaction.Count()
                                                        </MudChip>
                                                    }
                                                </div>
                                            }
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                                                @TimeFor(msg.CreatedAtUtc)
                                                @if (msg.EditedAtUtc.HasValue)
                                                {
                                                    <span> (edited)</span>
                                                }
                                                @if (msg.IsPinned)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Outlined.PushPin" Size="Size.Small" Class="ml-1" />
                                                }
                                            </MudText>
                                        </div>
                                    }
                                </div>
                                @if (block.IsOwn)
                                {
                                    <MudAvatar Size="Size.Small" Color="Color.Secondary" Class="ml-2">@InitialsFor(block.Author, block.AuthorId)</MudAvatar>
                                }
                            </div>
                        }
                    }
                }
            </div>

            @* Typing indicator *@
            @if (_typingUsers.Count > 0)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="px-3 py-1">
                    @TypingNames @(_typingUsers.Count == 1 ? "is" : "are") typing...
                </MudText>
            }

            @* Composer *@
            <MudPaper Class="d-flex align-center pa-2 mt-1" Elevation="0" Style="border-radius: var(--mud-default-border-radius);">
                <MudTextField @bind-Value="_messageText" Placeholder="Type a message..." Immediate="true"
                              DebounceInterval="300" OnDebounceIntervalElapsed="SendTypingIndicator"
                              OnKeyDown="HandleKeyDown" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Class="flex-grow-1" Lines="1" aria-label="Message" />
                <MudIconButton Icon="@Icons.Material.Outlined.Send" Color="Color.Primary" Size="Size.Small"
                               aria-label="Send message"
                               OnClick="SendMessage" Disabled="string.IsNullOrWhiteSpace(_messageText)" Class="ml-2" />
            </MudPaper>
        }
    </MudItem>
</MudGrid>
