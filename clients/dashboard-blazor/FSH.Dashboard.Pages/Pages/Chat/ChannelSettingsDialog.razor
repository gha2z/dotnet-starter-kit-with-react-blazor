@using FSH.BlazorShared.Models.Chat
@using FSH.BlazorShared.Models.Identity
@using FSH.BlazorShared.Services
@using FSH.BlazorShared.Components
@inject IChatService ChatService
@inject IUserService UserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@* React parity (channel-settings.tsx): three sections, no tabs, gated by the
   channel-member role — General + member add/remove + Archive are admin-only;
   non-admins get a read-only member list and a Leave-channel danger action. *@
<MudDialog>
    <DialogContent>
        @if (_isSelfAdmin)
        {
            <MudForm @ref="_form" @bind-IsValid="_isValid">
                <MudTextField @bind-Value="_name" Label="Channel name" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Required="true" RequiredError="Name is required" MaxLength="80" Counter="80"
                              Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Tag" Immediate="true" />
                <MudTextField @bind-Value="_description" Label="Description (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                              Lines="3" MaxLength="300" Counter="300" Immediate="true" Class="mt-4" />
                <MudCheckBox @bind-Value="_isPrivate" Label="Private channel" Color="Color.Primary" Class="mt-2" />
            </MudForm>
        }

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2" Class="mb-2">Members (@_channel.Members.Count)</MudText>

        @if (_isSelfAdmin)
        {
            <MudTextField @bind-Value="_memberSearch" Label="Add members" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Placeholder="Search users…" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Search"
                          Immediate="true" DebounceInterval="250" OnDebounceIntervalElapsed="SearchUsersAsync" Class="mb-2" />
            @if (_searchResults.Count > 0)
            {
                <MudList T="string" Dense="true" Class="mb-2" Style="max-height:220px;overflow:auto;">
                    @foreach (var u in _searchResults)
                    {
                        var user = u;
                        <MudListItem T="string" OnClick="@(async () => await AddMemberAsync(user))">
                            <div class="d-flex align-center gap-2">
                                <MudAvatar Size="Size.Small" Color="Color.Primary">@Initials(user)</MudAvatar>
                                <div>
                                    <MudText Typo="Typo.body2">@user.FirstName @user.LastName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@user.Email</MudText>
                                </div>
                            </div>
                        </MudListItem>
                    }
                </MudList>
            }
        }

        <MudList T="string" Dense="true">
            @foreach (var m in _channel.Members.Take(20))
            {
                var member = m;
                var name = ResolveName(m.UserId);
                <MudListItem>
                    <div class="d-flex align-center gap-2">
                        <MudAvatar Size="Size.Small" Color="Color.Primary">@name[0]</MudAvatar>
                        <div class="flex-grow-1">
                            <MudText Typo="Typo.body2">@name @(m.UserId == SelfUserId ? "(you)" : "")</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@m.UserId</MudText>
                        </div>
                        @if (m.Role == ChannelMemberRole.Admin)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Primary" Class="font-weight-medium">Admin</MudText>
                        }
                        @if (_isSelfAdmin && m.UserId != SelfUserId)
                        {
                            <MudIconButton Icon="@Icons.Material.Outlined.Close" Size="Size.Small" aria-label="@($"Remove {name}")"
                                           OnClick="@(async () => await RemoveMemberAsync(member))" />
                        }
                    </div>
                </MudListItem>
            }
        </MudList>

        <MudDivider Class="my-4" />
        <MudText Typo="Typo.subtitle2">Danger zone</MudText>
        @if (_isSelfAdmin)
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">Archiving hides this channel for everyone.</MudText>
        }
        else
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">You will no longer see this channel's messages.</MudText>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        @if (_isSelfAdmin)
        {
            <MudButton Color="Color.Error" Variant="Variant.Text" OnClick="ArchiveChannel" Disabled="_busy">Archive</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync" Disabled="@(!_isValid || _busy)" Class="ml-auto">
                @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> } Save
            </MudButton>
        }
        else
        {
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="LeaveChannel" Disabled="_busy" Class="ml-auto">
                @if (_busy) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> } Leave channel
            </MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public ChannelDto Channel { get; set; } = null!;
    [Parameter] public string SelfUserId { get; set; } = string.Empty;
    [Parameter] public EventCallback OnChannelUpdated { get; set; }

    private MudForm _form = null!;
    private bool _isValid;
    private bool _busy;
    private string _name = string.Empty;
    private string _description = string.Empty;
    private bool _isPrivate;
    private string _memberSearch = string.Empty;
    private List<UserDto> _searchResults = new();
    private Dictionary<string, string> _memberNames = new();
    private ChannelDto _channel = null!;
    private bool _isSelfAdmin;

    protected override async Task OnInitializedAsync()
    {
        _channel = Channel;
        _isSelfAdmin = _channel.Members.Any(m => m.UserId == SelfUserId && m.Role == ChannelMemberRole.Admin)
                       || _channel.CreatedByUserId == SelfUserId;
        _name = _channel.Name ?? string.Empty;
        _description = _channel.Description ?? string.Empty;
        _isPrivate = _channel.IsPrivate;

        await ResolveMemberNamesAsync();

        if (_isSelfAdmin)
        {
            // React: dirty-tracking Save is disabled until something changes.
            _isValid = !string.IsNullOrWhiteSpace(_name);
        }
    }

    private async Task ResolveMemberNamesAsync()
    {
        _memberNames = new Dictionary<string, string>();
        var ids = _channel.Members.Select(m => m.UserId).Distinct().Take(20).ToList();
        var tasks = ids.Select(async id =>
        {
            try
            {
                var user = await UserService.GetAsync(id);
                if (user is not null)
                {
                    var full = $"{user.FirstName} {user.LastName}".Trim();
                    _memberNames[id] = string.IsNullOrWhiteSpace(full) ? (user.UserName ?? id[..8]) : full;
                }
            }
            catch { /* best-effort — falls back to short id */ }
        });
        await Task.WhenAll(tasks);
    }

    private string ResolveName(string userId) =>
        _memberNames.TryGetValue(userId, out var name) ? name : userId[..8];

    private static string Initials(UserDto u)
    {
        var a = string.IsNullOrWhiteSpace(u.FirstName) ? '?' : char.ToUpperInvariant(u.FirstName[0]);
        var b = string.IsNullOrWhiteSpace(u.LastName) ? '\0' : char.ToUpperInvariant(u.LastName[0]);
        return b == '\0' ? a.ToString() : $"{a}{b}";
    }

    private async Task SearchUsersAsync()
    {
        try
        {
            var result = await UserService.SearchAsync(new SearchRequest(1, 8, string.IsNullOrWhiteSpace(_memberSearch) ? null : _memberSearch.Trim()));
            var existing = _channel.Members.Select(m => m.UserId).ToHashSet();
            _searchResults = result.Items.Where(u => u.Id is not null && !existing.Contains(u.Id)).ToList();
        }
        catch { _searchResults = new(); }
    }

    private async Task AddMemberAsync(UserDto user)
    {
        _busy = true;
        try
        {
            await ChatService.AddChannelMembersAsync(_channel.Id, new AddChannelMembersRequest(new[] { user.Id! }));
            Snackbar.Add($"{user.FirstName} {user.LastName} added", Severity.Success);
            _searchResults = new();
            _memberSearch = string.Empty;
            _channel = await ChatService.GetChannelByIdAsync(_channel.Id);
            await ResolveMemberNamesAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Couldn't add member: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task RemoveMemberAsync(ChannelMemberDto member)
    {
        _busy = true;
        try
        {
            await ChatService.RemoveChannelMemberAsync(_channel.Id, member.UserId);
            Snackbar.Add("Member removed", Severity.Success);
            _channel = await ChatService.GetChannelByIdAsync(_channel.Id);
            await ResolveMemberNamesAsync();
        }
        catch (Exception ex) { Snackbar.Add($"Couldn't remove member: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task SaveAsync()
    {
        if (_form is not null) await _form.ValidateAsync();
        if (!_isValid) return;
        _busy = true;
        try
        {
            await ChatService.UpdateChannelAsync(_channel.Id, new UpdateChannelRequest(_name.Trim(), string.IsNullOrWhiteSpace(_description) ? null : _description.Trim(), _isPrivate));
            Snackbar.Add("Channel updated", Severity.Success);
            await OnChannelUpdated.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to update: {ex.Message}", Severity.Error);
        }
        finally { _busy = false; }
    }

    private async Task ArchiveChannel()
    {
        var parameters = new DialogParameters
        {
            { "Message", $"Archive \"{_channel.Name}\"? This will hide it for everyone." },
            { "ConfirmText", "Archive" },
            { "CancelText", "Cancel" }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<FshConfirmDialogContent>("Archive channel", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        _busy = true;
        try
        {
            await ChatService.ArchiveChannelAsync(_channel.Id);
            Snackbar.Add("Channel archived", Severity.Success);
            await OnChannelUpdated.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"Failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }

    private async Task LeaveChannel()
    {
        var parameters = new DialogParameters
        {
            { "Message", $"Leave \"{_channel.Name}\"? You will no longer see its messages." },
            { "ConfirmText", "Leave" },
            { "CancelText", "Cancel" }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.ExtraSmall };
        var dialog = await DialogService.ShowAsync<FshConfirmDialogContent>("Leave channel", parameters, options);
        var result = await dialog.Result;
        if (result is null || result.Canceled) return;
        _busy = true;
        try
        {
            await ChatService.RemoveChannelMemberAsync(_channel.Id, SelfUserId);
            Snackbar.Add("You left the channel.", Severity.Success);
            await OnChannelUpdated.InvokeAsync();
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex) { Snackbar.Add($"Failed: {ex.Message}", Severity.Error); }
        finally { _busy = false; }
    }
}
