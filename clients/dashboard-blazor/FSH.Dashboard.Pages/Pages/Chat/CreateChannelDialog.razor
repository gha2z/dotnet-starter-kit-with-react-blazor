@using FSH.BlazorShared.Services
@using FSH.BlazorShared.Models.Chat

<MudDialog>
    <DialogContent>
        <FshFormDialogHeader Icon="@Icons.Material.Outlined.Add"
                             Title="Create channel"
                             Description="Channels are team-wide conversations. Private channels are invite-only." />
        <MudForm @ref="_form" @bind-IsValid="_isValid">
            <MudTextField @bind-Value="_name" Label="Channel name" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Required="true" RequiredError="Name is required" MaxLength="80" Counter="80"
                          Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Outlined.Tag" Immediate="true" />
            <MudTextField @bind-Value="_description" Label="Description (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                          Lines="3" MaxLength="300" Counter="300" Immediate="true" Class="mt-4" />
            <MudCheckBox @bind-Value="_isPrivate" Label="Private channel" Color="Color.Primary" Class="mt-2" />
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel" Variant="Variant.Text">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="@(!_isValid || _saving)" Class="ml-auto">
            @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> } Create
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;
    [Inject] private IChatService ChatService { get; set; } = default!;
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    [Parameter] public EventCallback OnCreated { get; set; }

    private MudForm _form = null!;
    private bool _isValid;
    private string? _name;
    private string? _description;
    private bool _isPrivate;
    private bool _saving;

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await _form.ValidateAsync();
        if (!_isValid) return;

        _saving = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            await ChatService.CreateChannelAsync(new CreateChannelRequest(_name!.Trim(), _description, _isPrivate));
            Snackbar.Add("Channel created!", Severity.Success);
            await OnCreated.InvokeAsync();
            MudDialog.Close();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Failed to create channel: {ex.Message}", Severity.Error);
        }

        _saving = false;
    }
}
