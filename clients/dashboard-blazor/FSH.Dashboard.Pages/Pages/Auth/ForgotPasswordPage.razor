@page "/forgot-password"
@inject IAuthService AuthService
@inject NavigationManager Nav
@inject ISnackbar Snackbar

<div class="position-relative d-flex align-center justify-center" style="min-height: 100vh; background: var(--mud-palette-background); overflow: hidden;">
    <div class="fsh-orb" style="width: 420px; height: 420px; background: color-mix(in srgb, var(--mud-palette-primary) 6%, transparent); top: -120px; left: -80px;"></div>
    <div class="fsh-orb" style="width: 360px; height: 360px; background: color-mix(in srgb, var(--mud-palette-primary) 5%, transparent); bottom: -100px; right: -60px;"></div>

    <MudPaper Class="fsh-login-card pa-8 position-relative" Style="width: 420px; max-width: 92vw;" Elevation="0"
              Outlined="true">
        <div class="d-flex flex-column align-center mb-6">
            <div class="d-flex align-center gap-2 mb-3">
                <img src="/logo-fullstackhero.png" alt="fullstackhero" style="width: 36px; height: 36px; object-fit: contain;" />
                <span style="font-family: 'Outfit', var(--mud-typography-h5-family); font-size: 26px; font-weight: 600; letter-spacing: -0.02em; color: var(--mud-palette-text-primary);">
                    fullstack<span style="color: var(--mud-palette-primary);">hero</span>
                </span>
            </div>
            <div class="d-flex align-center gap-2 mt-1">
                <div style="height: 1px; width: 24px; background: var(--mud-palette-divider);"></div>
                <MudText Class="fsh-mono-label" Color="Color.Secondary">Tenant Console</MudText>
                <div style="height: 1px; width: 24px; background: var(--mud-palette-divider);"></div>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(_error))
        {
            <div role="alert" class="d-flex align-center gap-2 rounded-lg px-3 py-2 mb-4"
                 style="background: color-mix(in srgb, var(--mud-palette-error) 6%, transparent); border: 1px solid color-mix(in srgb, var(--mud-palette-error) 30%, transparent);">
                <MudIcon Icon="@Icons.Material.Filled.ReportGmailerrorred" Color="Color.Error" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-error);">@_error</MudText>
            </div>
        }

        @if (_success)
        {
            <div class="d-flex flex-column align-center text-center">
                <MudIcon Icon="@Icons.Material.Filled.MarkEmailRead" Class="mb-4" Size="Size.Large"
                         Style="color: var(--mud-palette-success);" />
                <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Check your inbox</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-4">
                    If an account exists for <strong>@_email</strong> in tenant <strong>@_tenant</strong>,
                    a one-time reset link is on its way. The link expires in 30 minutes.
                </MudText>
                <div class="d-flex flex-column align-start gap-1 mb-4" style="width: 100%;">
                    <MudText Typo="Typo.body2" Class="d-flex align-center gap-2" Style="color: var(--mud-palette-success);">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> Didn&apos;t get it? Wait a minute, then check spam.
                    </MudText>
                    <MudText Typo="Typo.body2" Class="d-flex align-center gap-2" Style="color: var(--mud-palette-success);">
                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" /> Still nothing? Confirm the email + tenant and try again.
                    </MudText>
                </div>
                <div class="d-flex justify-space-between" style="width: 100%;">
                    <MudButton Variant="Variant.Text" OnClick="@(() => { _success = false; _error = null; })">
                        Try a different address
                    </MudButton>
                    <MudButton Variant="Variant.Outlined" OnClick="@(() => Nav.NavigateTo("/login"))">
                        Back to Sign In
                    </MudButton>
                </div>
            </div>
        }
        else
        {
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mb-2">Reset your password</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mb-6">
                Enter the email you sign in with. We&apos;ll send a one-time reset link.
            </MudText>

            <MudForm @ref="_form" OnEnterPressed="SubmitAsync">
                <MudTextField @bind-Value="_tenant"
                              Label="Tenant"
                              For="@(() => _tenant)"
                              autocomplete="organization"
                              Placeholder="acme"
                              HelperText="Your tenant identifier"
                              Disabled="@_isSubmitting" />
                <MudTextField @bind-Value="_email"
                              Label="Email"
                              For="@(() => _email)"
                              autocomplete="email"
                              Placeholder="you@acme.example"
                              Required="true"
                              RequiredError="Email is required."
                              Disabled="@_isSubmitting"
                              Class="mt-4" />
                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="mt-6"
                           Disabled="@_isSubmitting"
                           OnClick="SubmitAsync">
                    @if (_isSubmitting)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    }
                    Send Reset Link
                </MudButton>
            </MudForm>
            <div class="text-center mt-4">
                <MudText Typo="Typo.body2" Color="Color.Secondary" Inline="true">Remembered it? </MudText>
                <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="@(() => Nav.NavigateTo("/login"))">
                    Sign in
                </MudButton>
            </div>
        }
    </MudPaper>
</div>

@code {
    private MudForm? _form;
    private string _email = string.Empty;
    private string _tenant = string.Empty;
    private bool _isSubmitting;
    private bool _success;
    private string? _error;

    private async Task SubmitAsync()
    {
        await _form!.ValidateAsync();
        if (!_form.IsValid) return;

        _isSubmitting = true;
        _error = null;
        try
        {
            await AuthService.ForgotPasswordAsync(_email, _tenant);
            _success = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
