@namespace FSH.BlazorShared.Components
@using MudBlazor

@* Shared CRUD-dialog header (React parity: components/ui/dialog DialogHeader —
   icon tile + title + muted description). Every add/edit dialog opens with this,
   so all CRUD dialogs share one chrome. *@

<div class="fsh-form-dialog-header">
    <FshToneIconTile Icon="@Icon" Tone="@(Tone ?? Color.Primary)" TileSize="32px" IconSize="Size.Small" />
    <div class="fsh-form-dialog-header-text">
        <MudText Typo="Typo.h6" Style="margin: 0; line-height: 1.3;">@Title</MudText>
        @if (!string.IsNullOrEmpty(Description))
        {
            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="display: block; margin-top: 2px;">
                @Description
            </MudText>
        }
    </div>
</div>

@code {
    /// <summary>Material icon for the tone tile (e.g. Icons.Material.Filled.Inventory2).</summary>
    [Parameter, EditorRequired] public string Icon { get; set; } = null!;

    /// <summary>Dialog headline — "Add a product" / "Edit brand" / …</summary>
    [Parameter, EditorRequired] public string Title { get; set; } = null!;

    /// <summary>Muted one-liner under the title (React DialogDescription parity).</summary>
    [Parameter] public string? Description { get; set; }

    /// <summary>Tile tone; defaults to primary. Use Color.Error for destructive dialogs.</summary>
    [Parameter] public Color? Tone { get; set; }
}
