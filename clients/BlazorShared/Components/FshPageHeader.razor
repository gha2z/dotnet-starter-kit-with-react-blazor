@namespace FSH.BlazorShared.Components
@using MudBlazor

<div class="d-flex flex-wrap align-end justify-space-between gap-3 mb-4">
    <div class="d-flex align-center gap-3">
        <FshToneIconTile Icon="@Icon" Tone="@Tone" TileSize="44px" IconSize="Size.Medium" />
        <div>
            <div class="d-flex align-center gap-2">
                <MudText Typo="Typo.h5" Class="font-weight-medium" Style="margin: 0;">@Title</MudText>
                @if (Count is not null)
                {
                    <span class="fsh-count-chip">@Count @Unit@(Count == 1 ? string.Empty : "s")</span>
                }
            </div>
            @if (!string.IsNullOrEmpty(Description))
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
            }
        </div>
    </div>
    <div class="d-flex gap-2">
        @ChildContent
    </div>
</div>

@code {
    /// <summary>
    /// Page header (React parity: tone icon tile + title + mono count chip + description + action slot).
    /// </summary>
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Description;
    [Parameter] public Color Tone { get; set; } = Color.Primary;
    [Parameter] public int? Count { get; set; }
    [Parameter] public string Unit { get; set; } = "item";
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
