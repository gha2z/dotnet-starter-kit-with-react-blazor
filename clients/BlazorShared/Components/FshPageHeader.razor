@namespace FSH.BlazorShared.Components

<MudContainer MaxWidth="MaxWidth.ExtraExtraLarge" Class="mb-4">
    <MudPaper Elevation="0" Class="d-flex align-center justify-space-between py-2">
        <div class="d-flex align-center gap-4">
            <MudIcon Icon="@Icon" Size="Size.Large" Color="Color.Primary" />
            <div>
                <MudText Typo="Typo.h5">@Title</MudText>
                @if (!string.IsNullOrEmpty(Description))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Description</MudText>
                }
            </div>
        </div>
        <div class="d-flex gap-2">
            @ChildContent
        </div>
    </MudPaper>
</MudContainer>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Description { get; set; }
    [Parameter] public string Icon { get; set; } = Icons.Material.Filled.Description;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
