@namespace FSH.BlazorShared.Components

<MudPaper Class="pa-8 ma-4" Elevation="2">
    <MudContainer Class="d-flex flex-column align-center justify-center" Style="min-height: 200px">
        <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Large" Color="Color.Error" />
        <MudText Typo="Typo.h5" Class="mt-4">Something went wrong</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-2 mb-4">
            @Message
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Reload">
            Reload Page
        </MudButton>
    </MudContainer>
</MudPaper>

@code {
    [Parameter] public string Message { get; set; } = "An unexpected error occurred. Please try again.";

    private void Reload()
    {
        NavigationManager nav;
        try
        {
            nav = NavigationManager!;
        }
        catch
        {
            return;
        }
        nav.NavigateTo(nav.Uri, forceLoad: true);
    }

    [Inject] private NavigationManager? NavigationManager { get; set; }
}
