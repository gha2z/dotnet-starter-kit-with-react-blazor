@namespace FSH.BlazorShared.Components
@implements IDisposable
@using FSH.BlazorShared.Realtime
@using FSH.BlazorShared.Services
@using Microsoft.AspNetCore.SignalR.Client
@using MudBlazor
@inject IChatService Chat
@inject IHubConnectionService Hub
@inject NavigationManager Nav

@* React parity: topbar pill that sums unread chat messages across every channel;
   brand-primary chip to distinguish from the destructive-red notification bell. *@
<div class="fsh-chat-unread">
    <MudIconButton Icon="@Icons.Material.Outlined.ChatBubbleOutline" Size="Size.Medium" aria-label="Chat"
                   title="@BadgeTitle"
                   OnClick='() => Nav.NavigateTo("/chat")' />
    @if (_unreadCount > 0)
    {
        <span class="fsh-chat-unread-badge">@(_unreadCount > 99 ? "99+" : _unreadCount.ToString())</span>
    }
</div>

@code {
    private int _unreadCount;
    private readonly List<IDisposable> _hubSubs = [];

    private string BadgeTitle => _unreadCount > 0
        ? $"{_unreadCount} unread chat message{(_unreadCount == 1 ? "" : "s")}"
        : "Chat";

    protected override void OnInitialized()
    {
        Hub.StateChanged += OnHubStateChanged;
        Nav.LocationChanged += OnLocationChanged;
    }

    protected override async Task OnInitializedAsync()
    {
        TrySubscribeHub();
        await RefreshAsync();
    }

    private void OnLocationChanged(object? sender, Microsoft.AspNetCore.Components.Routing.LocationChangedEventArgs e)
        => _ = RefreshAsync();

    private void OnHubStateChanged(HubConnectionState state)
    {
        _ = InvokeAsync(async () =>
        {
            if (state == HubConnectionState.Connected)
            {
                TrySubscribeHub();
            }
            else
            {
                foreach (var sub in _hubSubs)
                {
                    sub.Dispose();
                }

                _hubSubs.Clear();
            }

            await RefreshAsync();
            StateHasChanged();
        });
    }

    private void TrySubscribeHub()
    {
        if (_hubSubs.Count > 0 || Hub.State != HubConnectionState.Connected)
        {
            return;
        }

        _hubSubs.Add(Hub.On<object>("ChatMessageCreated", _ => InvokeAsync(RefreshAsync)));
        // The server pushes this to the user's group after MarkChannelRead —
        // mirrors React's markChannelRead invalidating my-channels, so the
        // badge clears the moment a channel is read instead of waiting for
        // the next navigation.
        _hubSubs.Add(Hub.On<object>("ChatChannelRead", _ => InvokeAsync(RefreshAsync)));
    }

    private async Task RefreshAsync()
    {
        try
        {
            var channels = await Chat.ListMyChannelsAsync(pageSize: 100);
            _unreadCount = channels.Sum(c => c.UnreadCount);
            await InvokeAsync(StateHasChanged);
        }
        catch
        {
            // Best-effort: the API may be unreachable while the shell renders.
        }
    }

    public void Dispose()
    {
        Hub.StateChanged -= OnHubStateChanged;
        Nav.LocationChanged -= OnLocationChanged;
        foreach (var sub in _hubSubs)
        {
            sub.Dispose();
        }

        _hubSubs.Clear();
    }
}