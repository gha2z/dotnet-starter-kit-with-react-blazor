<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FSH.Hybrid.Pages.SettingsPage"
             Title="Settings">
    <ScrollView>
        <VerticalStackLayout Padding="24" Spacing="16">

            <Label Text="Settings" FontSize="24" FontAttributes="Bold" />

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" />

            <Label Text="Security" FontSize="16" FontAttributes="Bold" />
            <Label Text="Require Face ID, fingerprint or Windows Hello to unlock your session when the app returns to the foreground. Tokens are stored in the platform keychain (SecureStorage)."
                   FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12" RowDefinitions="Auto">
                <Switch x:Name="BiometricSwitch" Grid.Column="0" Toggled="OnBiometricLockToggled" />
                <VerticalStackLayout Grid.Column="1" Spacing="2">
                    <Label Text="Biometric unlock" FontSize="14" FontAttributes="Bold" />
                    <Label x:Name="BiometricStatusLabel" Text="Checking availability…" FontSize="11" />
                </VerticalStackLayout>
            </Grid>

            <BoxView HeightRequest="1" Color="{AppThemeBinding Light=#E5E7EB, Dark=#374151}" />

            <Label Text="Connection" FontSize="16" FontAttributes="Bold" />
            <Label Text="API base URL (change before signing in if your API is not on the default endpoint):"
                   FontSize="12" TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />
            <Entry x:Name="ApiBaseEntry" Placeholder="https://localhost:7030" Completed="OnApiBaseChanged" />
            <Label x:Name="ApiBaseHintLabel" FontSize="11" TextColor="{AppThemeBinding Light=#6B7280, Dark=#9CA3AF}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
