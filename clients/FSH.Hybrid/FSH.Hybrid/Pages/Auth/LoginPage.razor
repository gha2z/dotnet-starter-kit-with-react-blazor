@page "/login"
@inject MauiAuthService Auth
@inject ITokenStore TokenStore
@inject NavigationManager Nav
@inject MauiAuthStateProvider HybridAuth
@inject IBiometricService Biometric

<div class="position-relative d-flex align-center justify-center" style="min-height: 100vh; background: var(--mud-palette-background); overflow: hidden;">
    <div class="fsh-orb" style="width: 420px; height: 420px; background: color-mix(in srgb, var(--mud-palette-primary) 6%, transparent); top: -120px; left: -80px;"></div>
    <div class="fsh-orb" style="width: 360px; height: 360px; background: color-mix(in srgb, var(--mud-palette-primary) 5%, transparent); bottom: -100px; right: -60px;"></div>

    <MudPaper Class="fsh-login-card pa-8 position-relative" Style="width: 420px; max-width: 92vw;" Elevation="0"
              Outlined="true">
        <div class="d-flex flex-column align-center mb-6">
            <FshToneIconTile Icon="@Icons.Material.Filled.Dashboard" Tone="Color.Primary" TileSize="44px" IconSize="Size.Medium" Class="mb-3" />
            <MudText Typo="Typo.h5" Align="Align.Center" Class="mt-2 font-weight-medium" Style="margin: 0;">Welcome back</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="mt-1">Sign in to your tenant workspace</MudText>
            <div class="d-flex align-center gap-2 mt-3">
                <div style="height: 1px; width: 24px; background: var(--mud-palette-divider);"></div>
                <MudText Class="fsh-mono-label" Color="Color.Secondary">Hybrid Shell</MudText>
                <div style="height: 1px; width: 24px; background: var(--mud-palette-divider);"></div>
            </div>
        </div>

        @if (_error is not null)
        {
            <div role="alert" class="d-flex align-center gap-2 rounded-lg px-3 py-2 mb-4"
                 style="background: color-mix(in srgb, var(--mud-palette-error) 6%, transparent); border: 1px solid color-mix(in srgb, var(--mud-palette-error) 30%, transparent);">
                <MudIcon Icon="@Icons.Material.Filled.ReportGmailerrorred" Color="Color.Error" Size="Size.Small" />
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-error);">@_error</MudText>
            </div>
        }

        <MudForm @ref="_form" Validation="@(new DataAnnotationsValidator())" OnEnterPressed="SubmitAsync">
            <MudTextField @bind-Value="_tenant"
                          Label="Tenant"
                          For="@(() => _tenant)"
                          autocomplete="organization"
                          Placeholder="acme"
                          HelperText="Your tenant identifier"
                          Disabled="@_isSubmitting" />
            <MudTextField @bind-Value="_email"
                          Label="Email"
                          For="@(() => _email)"
                          autocomplete="email"
                          Placeholder="you@acme.example"
                          Required="true"
                          RequiredError="Email is required."
                          Disabled="@_isSubmitting"
                          Class="mt-4" />
            <MudTextField @bind-Value="_password"
                          Label="Password"
                          For="@(() => _password)"
                          InputType="@(_showPassword ? InputType.Text : InputType.Password)"
                          autocomplete="current-password"
                          Required="true"
                          RequiredError="Password is required."
                          Disabled="@_isSubmitting"
                          Class="mt-4"
                          Adornment="Adornment.End"
                          AdornmentIcon="@(_showPassword ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                          AdornmentAriaLabel="@(_showPassword ? "Hide password" : "Show password")"
                          AdornmentColor="Color.Default"
                          OnAdornmentClick="TogglePasswordVisibility" />
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       FullWidth="true"
                       Class="mt-3"
                       ButtonType="ButtonType.Submit"
                       OnClick="SubmitAsync"
                       Disabled="@(_isSubmitting || string.IsNullOrWhiteSpace(_email) || string.IsNullOrWhiteSpace(_password))">
                @if (_isSubmitting)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                    <text>Signing in…</text>
                }
                else
                {
                    <text>Sign in</text>
                    <MudIcon Icon="@Icons.Material.Filled.ArrowForward" Size="Size.Small" Class="ml-1" />
                }
            </MudButton>
        </MudForm>

        @if (_hasSession || _biometricAvailable)
        {
            <MudDivider Class="my-6" />

            <div class="d-flex align-center justify-space-between gap-4">
                <div class="d-flex flex-column">
                    <MudText Typo="Typo.body2" Class="font-weight-medium">Biometric unlock</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Require Face ID / fingerprint / Windows Hello after backgrounding the app</MudText>
                </div>
                <MudSwitch T="bool" Value="@_lockEnabled" ValueChanged="OnLockToggleChanged" Color="Color.Primary" />
            </div>

            @if (_hasSession)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           FullWidth="true"
                           Class="mt-4"
                           StartIcon="@Icons.Material.Filled.Fingerprint"
                           OnClick="UnlockAsync"
                           Disabled="@_isUnlocking">
                    @if (_isUnlocking)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                        <text>Unlocking…</text>
                    }
                    else
                    {
                        <text>Unlock with biometrics</text>
                    }
                </MudButton>
            }
        }

        <div class="d-flex align-center justify-center gap-2 mt-6">
            <MudIcon Icon="@Icons.Material.Filled.Shield" Size="Size.Small" Color="Color.Secondary" />
            <MudText Typo="Typo.caption" Color="Color.Secondary">Tokens stored in the platform keychain</MudText>
        </div>
    </MudPaper>
</div>
