<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="FSH.Hybrid.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:hybrid="clr-namespace:FSH.Hybrid"
    xmlns:pages="clr-namespace:FSH.Hybrid.Pages"
    Shell.FlyoutBehavior="Flyout"
    Shell.NavBarIsVisible="False"
    Title="FSH Hybrid">

    <FlyoutItem Title="FSH Hybrid" FlyoutDisplayOptions="AsMultipleItems">
        <TabBar>
            <ShellContent Title="Dashboard" Route="home" ContentTemplate="{DataTemplate hybrid:MainPage}" />
            <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
            <ShellContent Title="About" Route="about" ContentTemplate="{DataTemplate pages:AboutPage}" />
        </TabBar>
    </FlyoutItem>

</Shell>
